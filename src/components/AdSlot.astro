---
// AdSense placeholder — currently DISABLED.
// To activate after AdSense approval, see BaseLayout.astro and global.css.
interface Props {
  position: "top" | "middle" | "bottom" | "sidebar";
}

const { position } = Astro.props;

const heightMap = {
  top: "min-h-[90px]",
  middle: "min-h-[90px]",
  bottom: "min-h-[90px]",
  sidebar: "min-h-[250px]",
};

const labelMap = {
  top: "Advertisement",
  middle: "Advertisement",
  bottom: "Advertisement",
  sidebar: "Advertisement",
};
---

<div
  class="ad-slot {heightMap[position]} mb-6"
  data-ad-slot="kitchencalc-{position}"
  aria-label={labelMap[position]}
  role="complementary"
>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
    data-ad-slot="XXXXXXXXXX"
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
</div>

<style>
  .ad-slot {
    opacity: 0;
  }
  .ad-slot:has(ins[data-ad-status="filled"]) {
    opacity: 1;
  }
</style>
