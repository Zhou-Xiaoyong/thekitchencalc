---
const navItems = [
  { href: "/recipe-servings-calculator/", label: "Servings" },
  { href: "/cooking-time-calculator/", label: "Cook Time" },
  { href: "/holiday-meal-planner/", label: "Holidays" },
  { href: "/kitchen-measurement-converter/", label: "Measure" },
  { href: "/baking-pan-converter/", label: "Pans" },
  { href: "/oven-temperature-converter/", label: "Oven Temp" },
  { href: "/ingredient-substitution-finder/", label: "Substitutes" },
];
---

<header class="bg-white border-b border-border sticky top-0 z-50" role="banner">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 no-underline hover:opacity-90 transition-opacity"
        aria-label="The Kitchen Calc - Home"
      >
        <span class="text-2xl" aria-hidden="true">🥘</span>
        <span class="font-bold text-lg text-secondary hidden sm:inline">
          The Kitchen Calc
        </span>
        <span class="font-bold text-lg text-secondary sm:hidden">KitchenCalc</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 rounded-lg text-sm font-medium text-text-light hover:text-primary hover:bg-primary-light/30 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden tap-target flex flex-col gap-1.5 p-2 rounded-lg hover:bg-cream transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="block w-5 h-0.5 bg-secondary rounded-full transition-transform"></span>
        <span class="block w-5 h-0.5 bg-secondary rounded-full transition-opacity"></span>
        <span class="block w-5 h-0.5 bg-secondary rounded-full transition-transform"></span>
      </button>
    </div>

    <!-- Mobile Nav (hidden by default) -->
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-border py-3 pb-4 space-y-1"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-3 rounded-lg text-base font-medium text-text-light hover:text-primary hover:bg-primary-light/20 transition-colors tap-target"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/about/"
        class="block px-3 py-3 rounded-lg text-base font-medium text-text-light hover:text-primary hover:bg-primary-light/20 transition-colors tap-target"
      >
        About
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  }
</script>
