const categoryProducts = products[category] || products.general;

function getAmazonUrl(asin: string): string {
  return `https://www.amazon.com/dp/${asin}/?tag=${affiliateId}&linkCode=ogi&th=1&psc=1`;
}
---

<div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 mt-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-secondary">{title}</h2>
    <span class="text-xs text-text-light italic">As an Amazon Associate we earn from qualifying purchases.</span>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {categoryProducts.map((product) => (
      <a
        href={getAmazonUrl(product.asin)}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="group block bg-cream/50 rounded-xl p-4 hover:shadow-md hover:border-primary/30 border border-transparent transition-all no-underline"
      >
        <div class="aspect-square bg-white rounded-lg mb-3 flex items-center justify-center overflow-hidden">
          <img
            src={product.image}
            alt={product.name}
            loading="lazy"
            class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
            onerror="this.style.display='none'"
          />
        </div>
        <h3 class="text-sm font-bold text-secondary mb-1 group-hover:text-primary transition-colors line-clamp-2">
          {product.name}
        </h3>
        <p class="text-lg font-extrabold text-primary mb-2">{product.price}</p>
        <p class="text-xs text-text-light line-clamp-2">{product.description}</p>
        <div class="mt-3 flex items-center gap-1 text-xs font-medium text-primary">
          <span>View on Amazon</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M7 17L17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>
