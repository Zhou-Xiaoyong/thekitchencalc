const categoryProducts = products[category] || products.general;

function getAmazonSearchUrl(searchTerm: string): string {
  // 使用Amazon搜索链接，更可靠且包含联盟追踪
  return `https://www.amazon.com/s?k=${searchTerm}&tag=${affiliateId}`;
}
---

<div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 mt-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-secondary">{title}</h2>
    <span class="text-xs text-text-light italic">As an Amazon Associate we earn from qualifying purchases.</span>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {categoryProducts.map((product) => (
      <a
        href={getAmazonSearchUrl(product.searchTerm)}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="group block bg-cream/50 rounded-xl p-4 hover:shadow-md hover:border-primary/30 border border-transparent transition-all no-underline"
      >
        <h3 class="text-sm font-bold text-secondary mb-2 group-hover:text-primary transition-colors">
          {product.name}
        </h3>
        <p class="text-lg font-extrabold text-primary mb-2">{product.price}</p>
        <p class="text-xs text-text-light mb-3">{product.description}</p>
        <div class="flex items-center gap-1 text-xs font-medium text-primary">
          <span>Shop on Amazon</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M7 17L17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>