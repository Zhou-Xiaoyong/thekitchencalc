---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import AmazonProducts from "../components/AmazonProducts.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Recipe Cost Calculator",
  url: "https://thekitchencalc.com/recipe-cost-calculator/",
  description: "Calculate the cost of your recipes. Enter ingredients and quantities to find out the total cost and cost per serving. Great for meal planning and small businesses.",
  applicationCategory: "CookingApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title="Recipe Cost Calculator — Food Cost Per Serving"
  description="Calculate the total cost and per-serving cost of any recipe. Enter your ingredients and prices to see exactly how much your meals cost. Perfect for meal planning and home bakers."
  canonical="https://thekitchencalc.com/recipe-cost-calculator/"
  schema={schema}
>
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Recipe Cost <span class="text-primary">Calculator</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Find out exactly how much your recipes cost. Add ingredients, quantities, and prices to see total cost and cost per serving. Perfect for meal planning and home bakers.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <AdSlot position="top" />

    <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label for="recipe-name" class="block text-sm font-semibold text-secondary mb-2">
            Recipe Name
          </label>
          <input
            type="text"
            id="recipe-name"
            value="Chocolate Chip Cookies"
            placeholder="e.g. Chocolate Chip Cookies"
            class="w-full px-4 py-3 border border-border rounded-xl text-base font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
          />
        </div>
        <div>
          <label for="servings" class="block text-sm font-semibold text-secondary mb-2">
            Servings / Yield
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="servings"
              min="1"
              value="24"
              class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
              inputmode="numeric"
            />
            <select
              id="yield-type"
              class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
            >
              <option value="cookies" selected>cookies</option>
              <option value="servings">servings</option>
              <option value="pieces">pieces</option>
              <option value="muffins">muffins</option>
              <option value="slices">slices</option>
            </select>
          </div>
        </div>
      </div>

      <h2 class="text-lg font-bold text-secondary mb-3">Ingredients</h2>
      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <table class="w-full min-w-[500px]" id="ingredients-table">
          <thead>
            <tr class="text-xs font-semibold text-text-light uppercase tracking-wider border-b border-border">
              <th class="text-left py-3 pr-2 pl-4 sm:pl-0 w-8">#</th>
              <th class="text-left py-3 px-2">Ingredient</th>
              <th class="text-right py-3 px-2 w-20">Amount</th>
              <th class="text-left py-3 px-2 w-24">Unit</th>
              <th class="text-right py-3 px-2 w-28">Package Price</th>
              <th class="text-right py-3 px-2 w-20">Package Size</th>
              <th class="text-right py-3 pl-2 pr-4 sm:pr-0 w-12"></th>
            </tr>
          </thead>
          <tbody id="ingredients-body">
          </tbody>
        </table>
      </div>

      <button
        id="add-ingredient"
        class="mt-4 w-full sm:w-auto px-5 py-3 border-2 border-dashed border-border rounded-xl text-sm font-semibold text-text-light hover:border-primary hover:text-primary hover:bg-primary-light/20 transition-all flex items-center justify-center gap-2 tap-target"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Ingredient
      </button>

      <div class="mt-4 flex flex-wrap gap-2">
        <span class="text-xs text-text-light font-medium self-center mr-1">Quick fill:</span>
        <button onclick="fillSampleCookies()" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">
          Cookie Recipe
        </button>
        <button onclick="fillSamplePasta()" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">
          Pasta Dinner
        </button>
        <button onclick="clearAll()" class="px-3 py-1.5 text-xs font-medium text-red-500 bg-red-50 hover:bg-red-100 rounded-lg transition-colors">
          Clear All
        </button>
      </div>

      <button
        id="calculate-btn"
        class="mt-6 w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
      >
        Calculate Recipe Cost
      </button>
    </div>

    <AdSlot position="middle" />

    <div id="results-section" class="hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
        <h2 class="text-xl font-bold text-secondary mb-4" id="result-title">Recipe Cost Breakdown</h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="bg-cream/50 rounded-xl p-4 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Total Cost</p>
            <p class="text-2xl font-extrabold text-primary" id="total-cost">$0.00</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-4 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Per Serving</p>
            <p class="text-2xl font-extrabold text-secondary" id="per-serving">$0.00</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-4 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Ingredients</p>
            <p class="text-2xl font-extrabold text-text-light" id="ingredient-count">0</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-4 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Servings</p>
            <p class="text-2xl font-extrabold text-text-light" id="servings-count">0</p>
          </div>
        </div>

        <h3 class="font-semibold text-secondary mb-3">Cost Breakdown</h3>
        <div id="cost-breakdown" class="space-y-2 mb-6">
        </div>

        <div class="p-4 bg-cream rounded-xl">
          <h3 class="font-bold text-secondary mb-2">💡 Food Cost Tips</h3>
          <ul class="text-sm text-text-light space-y-1 list-disc list-inside">
            <li>Restaurants typically aim for 25-35% food cost (price = cost ÷ 0.30)</li>
            <li>Buy in bulk for ingredients you use frequently</li>
            <li>Consider overhead: electricity, gas, equipment wear, packaging</li>
            <li>Seasonal produce can dramatically change recipe costs</li>
          </ul>
        </div>
      </div>
    </div>

    <AmazonProducts category="general" title="Kitchen Essentials" />

    <AdSlot position="bottom" />

    <article class="mt-8 bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none">
      <h2>How to Use the Recipe Cost Calculator</h2>
      <ol>
        <li><strong>Name your recipe</strong> — Give it a name so you can reference it later.</li>
        <li><strong>Set servings</strong> — How many servings or pieces does the recipe make?</li>
        <li><strong>Add ingredients</strong> — For each ingredient, enter the name, amount used, unit, package price, and package size.</li>
        <li><strong>Calculate</strong> — See total recipe cost and cost per serving with a full breakdown.</li>
      </ol>

      <h2>What's Included in Recipe Cost?</h2>
      <h3>Direct Food Costs</h3>
      <p>
        The ingredients themselves — flour, sugar, butter, eggs, meat, produce, etc.
        This calculator focuses on direct food costs.
      </p>
      <h3>Indirect Costs (Not Included Here)</h3>
      <ul>
        <li><strong>Utilities:</strong> Gas, electricity for cooking and baking</li>
        <li><strong>Equipment:</strong> Pans, mixers, utensils (wear and tear)</li>
        <li><strong>Labor:</strong> Your time (if selling)</li>
        <li><strong>Packaging:</strong> Boxes, bags, labels, containers</li>
        <li><strong>Waste:</strong> Trimmings, spoilage, mistakes</li>
      </ul>

      <h2>Pricing Baked Goods for Sale</h2>
      <p>
        If you're selling baked goods, a common formula is:
      </p>
      <p><strong>Sale Price = Total Food Cost ÷ Target Food Cost Percentage</strong></p>
      <p>
        Most bakeries aim for 25-35% food cost. So if your ingredients cost $2.00 per cookie batch
        (and you make 24 cookies), your per-cookie food cost is about $0.08.
        At a 30% food cost, you'd charge about $0.27 per cookie — or $6.50 per dozen.
      </p>
      <p>
        But don't forget to account for labor, utilities, packaging, and profit!
        Many home bakers use a simpler formula: <strong>cost × 3</strong> as a starting price.
      </p>

      <h2>Ways to Reduce Recipe Costs</h2>
      <ul>
        <li><strong>Buy in bulk:</strong> Warehouse clubs and bulk stores often have better unit prices</li>
        <li><strong>Shop sales:</strong> Stock up on non-perishables when they're on sale</li>
        <li><strong>Use seasonal produce:</strong> Fruits and vegetables are cheaper in season</li>
        <li><strong>Generic vs. brand name:</strong> Store brands are often identical quality at lower prices</li>
        <li><strong>Reduce waste:</strong> Plan meals to use up ingredients before they spoil</li>
        <li><strong>Grow your own:</strong> Herbs and some vegetables are easy to grow at home</li>
      </ul>
    </article>
  </section>
</BaseLayout>

<script>
  const units = [
    { value: "cup", label: "cup(s)" },
    { value: "tbsp", label: "tbsp" },
    { value: "tsp", label: "tsp" },
    { value: "g", label: "gram(s)" },
    { value: "kg", label: "kg" },
    { value: "oz", label: "oz" },
    { value: "lb", label: "lb" },
    { value: "ml", label: "mL" },
    { value: "whole", label: "whole/each" },
  ];

  const packageUnits = [
    { value: "lb", label: "lb" },
    { value: "oz", label: "oz" },
    { value: "kg", label: "kg" },
    { value: "g", label: "g" },
    { value: "cup", label: "cup" },
    { value: "each", label: "each/ct" },
    { value: "dozen", label: "dozen" },
  ];

  // Grams per US cup (240 mL) for common ingredients, used for volume → gram conversion.
  const INGREDIENT_DENSITY: Record<string, number> = {
    "flour": 120, "bread flour": 120, "cake flour": 110, "oat flour": 100,
    "sugar": 200, "granulated sugar": 200, "white sugar": 200, "caster sugar": 200,
    "brown sugar": 220, "brown sugar (packed)": 220, "powdered sugar": 120, "confectioners sugar": 120, "icing sugar": 120,
    "butter": 227, "unsalted butter": 227, "salted butter": 227, "margarine": 227,
    "oil": 218, "vegetable oil": 218, "olive oil": 218, "coconut oil": 218,
    "honey": 340, "maple syrup": 322, "corn syrup": 320,
    "milk": 240, "water": 240, "broth": 240, "cream": 240, "buttermilk": 240,
    "salt": 292, "table salt": 292, "kosher salt": 240, "sea salt": 290,
    "baking soda": 220, "baking powder": 220, "cocoa": 100, "cocoa powder": 100,
    "chocolate": 170, "chocolate chips": 170,
    "oats": 90, "rolled oats": 90, "rice": 185,
    "cheese": 113, "shredded cheese": 113, "parmesan": 113,
    "nuts": 120, "almonds": 120, "walnuts": 120, "pecans": 120,
    "peanut butter": 270, "yogurt": 245, "sour cream": 240,
    "vanilla": 240, "extract": 240,
  };

  // Match an ingredient name to its density (grams per cup). Falls back to a neutral value.
  function densityFor(name: string): number {
    const n = (name || "").toLowerCase();
    for (const key of Object.keys(INGREDIENT_DENSITY)) {
      if (n.includes(key)) return INGREDIENT_DENSITY[key];
    }
    return 200; // neutral default for unknown dry ingredients
  }

  const WEIGHT_TO_GRAMS: Record<string, number> = {
    g: 1, kg: 1000, oz: 28.3495, lb: 453.592,
  };

  function volumeToGrams(amount: number, unit: string, density: number): number {
    switch (unit) {
      case "cup": return amount * density;
      case "tbsp": return amount * density / 16;
      case "tsp": return amount * density / 48;
      case "ml": return amount * (density / 240);
      default: return amount * density;
    }
  }

  // Convert any ingredient amount to grams, using its density for volume units.
  function amountToGrams(amount: number, unit: string, density: number): number {
    if (unit in WEIGHT_TO_GRAMS) return amount * WEIGHT_TO_GRAMS[unit];
    if (unit === "whole") return amount * 50;
    if (unit === "dozen") return amount * 600;
    return volumeToGrams(amount, unit, density);
  }

  interface Ingredient {
    name: string;
    amount: string;
    unit: string;
    packagePrice: string;
    packageSize: string;
    packageUnit: string;
  }

  let ingredients: Ingredient[] = [];

  function renderTable() {
    const tbody = document.getElementById("ingredients-body")!;
    tbody.innerHTML = ingredients
      .map(
        (ing, i) => `
      <tr class="border-b border-border/50 hover:bg-cream/50 transition-colors">
        <td class="py-3 pr-2 pl-4 sm:pl-0 text-sm text-text-light">${i + 1}</td>
        <td class="py-3 px-2">
          <input
            type="text"
            class="ing-name w-full px-3 py-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
            value="${ing.name}"
            placeholder="e.g. All-purpose flour"
          />
        </td>
        <td class="py-3 px-2">
          <input
            type="number"
            step="any"
            class="ing-amount w-full px-3 py-2 border border-border rounded-lg text-sm text-right focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
            value="${ing.amount}"
            min="0"
            inputmode="decimal"
          />
        </td>
        <td class="py-3 px-2">
          <select class="ing-unit w-full px-2 py-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
            ${units
              .map(
                (u) =>
                  `<option value="${u.value}" ${u.value === ing.unit ? "selected" : ""}>${u.label}</option>`
              )
              .join("")}
          </select>
        </td>
        <td class="py-3 px-2">
          <div class="flex items-center">
            <span class="text-sm text-text-light mr-1">$</span>
            <input
              type="number"
              step="0.01"
              class="ing-price w-full px-2 py-2 border border-border rounded-lg text-sm text-right focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
              value="${ing.packagePrice}"
              min="0"
              inputmode="decimal"
            />
          </div>
        </td>
        <td class="py-3 px-2">
          <div class="flex gap-1">
            <input
              type="number"
              step="any"
              class="ing-pkg-size w-14 px-2 py-2 border border-border rounded-lg text-sm text-right focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
              value="${ing.packageSize}"
              min="0"
              inputmode="decimal"
            />
            <select class="ing-pkg-unit w-16 px-1 py-2 border border-border rounded-lg text-xs focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
              ${packageUnits
                .map(
                  (u) =>
                    `<option value="${u.value}" ${u.value === ing.packageUnit ? "selected" : ""}>${u.label}</option>`
                )
                .join("")}
            </select>
          </div>
        </td>
        <td class="py-3 pl-2 pr-4 sm:pr-0 text-center">
          <button
            class="remove-ing tap-target text-red-400 hover:text-red-600 transition-colors p-1"
            data-index="${i}"
            aria-label="Remove ingredient"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </td>
      </tr>
    `
      )
      .join("");

    tbody.querySelectorAll(".remove-ing").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        ingredients.splice(idx, 1);
        renderTable();
      });
    });
  }

  function syncFromTable() {
    const rows = document.querySelectorAll("#ingredients-body tr");
    ingredients = Array.from(rows).map((row) => ({
      name: (row.querySelector(".ing-name") as HTMLInputElement).value,
      amount: (row.querySelector(".ing-amount") as HTMLInputElement).value,
      unit: (row.querySelector(".ing-unit") as HTMLSelectElement).value,
      packagePrice: (row.querySelector(".ing-price") as HTMLInputElement).value,
      packageSize: (row.querySelector(".ing-pkg-size") as HTMLInputElement).value,
      packageUnit: (row.querySelector(".ing-pkg-unit") as HTMLSelectElement).value,
    }));
  }

  function addIngredient(name = "", amount = "", unit = "cup", price = "", pkgSize = "", pkgUnit = "lb") {
    ingredients.push({ name, amount, unit, packagePrice: price, packageSize: pkgSize, packageUnit: pkgUnit });
    renderTable();
  }

  function clearAll() {
    ingredients = [];
    renderTable();
    document.getElementById("results-section")!.classList.add("hidden");
  }

  function fillSampleCookies() {
    ingredients = [
      { name: "All-purpose flour", amount: "2.25", unit: "cup", packagePrice: "2.99", packageSize: "5", packageUnit: "lb" },
      { name: "Butter (unsalted)", amount: "1", unit: "cup", packagePrice: "4.99", packageSize: "1", packageUnit: "lb" },
      { name: "Granulated sugar", amount: "0.75", unit: "cup", packagePrice: "3.49", packageSize: "5", packageUnit: "lb" },
      { name: "Brown sugar (packed)", amount: "0.75", unit: "cup", packagePrice: "2.79", packageSize: "2", packageUnit: "lb" },
      { name: "Eggs", amount: "2", unit: "whole", packagePrice: "3.99", packageSize: "12", packageUnit: "each" },
      { name: "Vanilla extract", amount: "2", unit: "tsp", packagePrice: "5.99", packageSize: "4", packageUnit: "oz" },
      { name: "Baking soda", amount: "1", unit: "tsp", packagePrice: "1.29", packageSize: "1", packageUnit: "lb" },
      { name: "Salt", amount: "0.5", unit: "tsp", packagePrice: "0.99", packageSize: "26", packageUnit: "oz" },
      { name: "Chocolate chips", amount: "2", unit: "cup", packagePrice: "3.99", packageSize: "12", packageUnit: "oz" },
    ];
    (document.getElementById("recipe-name") as HTMLInputElement).value = "Chocolate Chip Cookies";
    (document.getElementById("servings") as HTMLInputElement).value = "24";
    (document.getElementById("yield-type") as HTMLSelectElement).value = "cookies";
    renderTable();
  }

  function fillSamplePasta() {
    ingredients = [
      { name: "Spaghetti", amount: "1", unit: "lb", packagePrice: "1.49", packageSize: "1", packageUnit: "lb" },
      { name: "Olive oil", amount: "2", unit: "tbsp", packagePrice: "8.99", packageSize: "16.9", packageUnit: "oz" },
      { name: "Garlic cloves", amount: "4", unit: "whole", packagePrice: "0.99", packageSize: "3", packageUnit: "each" },
      { name: "Crushed tomatoes", amount: "28", unit: "oz", packagePrice: "1.79", packageSize: "28", packageUnit: "oz" },
      { name: "Parmesan cheese", amount: "0.5", unit: "cup", packagePrice: "5.99", packageSize: "8", packageUnit: "oz" },
      { name: "Fresh basil", amount: "0.25", unit: "cup", packagePrice: "2.99", packageSize: "1", packageUnit: "each" },
      { name: "Red pepper flakes", amount: "0.5", unit: "tsp", packagePrice: "2.49", packageSize: "2", packageUnit: "oz" },
    ];
    (document.getElementById("recipe-name") as HTMLInputElement).value = "Spaghetti with Tomato Sauce";
    (document.getElementById("servings") as HTMLInputElement).value = "4";
    (document.getElementById("yield-type") as HTMLSelectElement).value = "servings";
    renderTable();
  }

  function calculate() {
    syncFromTable();
    const recipeName = (document.getElementById("recipe-name") as HTMLInputElement).value || "Your Recipe";
    const servings = parseFloat((document.getElementById("servings") as HTMLInputElement).value) || 1;
    const yieldType = (document.getElementById("yield-type") as HTMLSelectElement).value;

    let totalCost = 0;
    const breakdown: { name: string; cost: number; pct: number }[] = [];

    ingredients.forEach((ing) => {
      const amt = parseFloat(ing.amount) || 0;
      const price = parseFloat(ing.packagePrice) || 0;
      const pkgSize = parseFloat(ing.packageSize) || 0;

      if (amt <= 0 || price <= 0 || pkgSize <= 0) return;

      const density = densityFor(ing.name);
      const usedGrams = amountToGrams(amt, ing.unit, density);
      const pkgGrams = amountToGrams(pkgSize, ing.packageUnit, density);
      const cost = (usedGrams / pkgGrams) * price;

      totalCost += cost;
      breakdown.push({ name: ing.name || "Unnamed ingredient", cost, pct: 0 });
    });

    breakdown.forEach((b) => {
      b.pct = totalCost > 0 ? (b.cost / totalCost) * 100 : 0;
    });
    breakdown.sort((a, b) => b.cost - a.cost);

    const perServing = totalCost / servings;

    document.getElementById("result-title")!.textContent = `${recipeName} — Cost Breakdown`;
    document.getElementById("total-cost")!.textContent = `$${totalCost.toFixed(2)}`;
    document.getElementById("per-serving")!.textContent = `$${perServing.toFixed(2)}`;
    document.getElementById("ingredient-count")!.textContent = String(breakdown.length);
    document.getElementById("servings-count")!.textContent = `${servings} ${yieldType}`;

    const breakdownDiv = document.getElementById("cost-breakdown")!;
    if (breakdown.length === 0) {
      breakdownDiv.innerHTML = '<p class="text-text-light text-center py-4">Add ingredients with prices to see cost breakdown.</p>';
    } else {
      breakdownDiv.innerHTML = breakdown
        .map(
          (b) => `
        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-cream/30">
          <div class="flex-1">
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm font-medium text-secondary">${b.name}</span>
              <span class="text-sm font-bold text-text">$${b.cost.toFixed(2)}</span>
            </div>
            <div class="w-full bg-white rounded-full h-1.5">
              <div class="bg-primary h-1.5 rounded-full transition-all" style="width: ${b.pct}%"></div>
            </div>
            <p class="text-xs text-text-light mt-0.5">${b.pct.toFixed(1)}% of total cost</p>
          </div>
        </div>
      `
        )
        .join("");
    }

    document.getElementById("results-section")!.classList.remove("hidden");
    document.getElementById("results-section")!.scrollIntoView({ behavior: "smooth" });
  }

  document.addEventListener("DOMContentLoaded", () => {
    fillSampleCookies();
