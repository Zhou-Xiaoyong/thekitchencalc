---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "The Kitchen Calc",
  url: "https://thekitchencalc.com",
  description:
    "Free kitchen calculators for home cooks. Scale recipes, convert measurements, adjust cooking times, plan holiday meals, substitute ingredients, calculate yeast and dough hydration, and more. No sign-up required.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is this website really free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, 100% free. We support the site with advertising and affiliate commissions. No paywalls, no \"pro\" subscriptions, no sign-ups required. Just free calculators for home cooks.",
      },
    },
    {
      "@type": "Question",
      name: "How many calculators do you have?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We have 15+ free kitchen calculators covering recipe scaling, measurement conversion, baking math, brining, food safety, holiday meal planning, and more. We're always adding new tools!",
      },
    },
    {
      "@type": "Question",
      name: "Are the calculations accurate?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Our calculators use standard culinary ratios and USDA guidelines. They provide reliable estimates, but always use your own judgment and a food thermometer when cooking. Baking, in particular, can be sensitive to scaling — test large batch changes cautiously.",
      },
    },
    {
      "@type": "Question",
      name: "Do you support units used outside the US?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most of our calculators support both US customary units (cups, pounds, Fahrenheit) and metric units (grams, milliliters, Celsius). We default to US units because our audience is primarily American home cooks.",
      },
    },
  ],
};

const tools = [
  {
    icon: "🧮",
    title: "Recipe Servings Calculator",
    description:
      "Scale any recipe up or down in seconds. Enter your ingredients, original servings, and target servings. We handle the fractions.",
    href: "/recipe-servings-calculator/",
    keywords: "recipe scaling, servings converter, ingredient calculator, double recipe, half recipe",
  },
  {
    icon: "🦃",
    title: "Holiday Meal Planner",
    description:
      "Plan the perfect holiday meal or party. Thanksgiving, Christmas, Easter, Super Bowl, 4th of July BBQ — get exact food amounts for any guest count.",
    href: "/holiday-meal-planner/",
    keywords: "thanksgiving calculator, christmas dinner planner, holiday food planner, turkey servings, super bowl party, bbq calculator",
  },
  {
    icon: "⚖️",
    title: "Kitchen Measurement Converter",
    description:
      "Convert cups to grams, tablespoons to milliliters, ounces to cups. Includes ingredient-specific density for flour, sugar, butter, and more.",
    href: "/kitchen-measurement-converter/",
    keywords: "cups to grams, measurement converter, tbsp to ml, kitchen conversion, ounce to cup",
  },
  {
    icon: "🍞",
    title: "Yeast Calculator",
    description:
      "Calculate exact yeast amounts for bread, pizza, and more. Convert between active dry, instant, rapid-rise, and fresh yeast with baker's percentages.",
    href: "/yeast-calculator/",
    keywords: "yeast calculator, bread yeast, pizza dough yeast, instant yeast conversion, active dry yeast",
  },
  {
    icon: "💧",
    title: "Dough Hydration Calculator",
    description:
      "Calculate dough hydration percentage for bread, pizza, and sourdough. Or work backwards to hit your target hydration ratio perfectly.",
    href: "/dough-hydration-calculator/",
    keywords: "dough hydration, baker's percentage, bread hydration, pizza dough, sourdough calculator",
  },
  {
    icon: "🧂",
    title: "Brine Calculator",
    description:
      "Perfect brine every time. Calculate exact salt, sugar, and water amounts for turkey, chicken, pork chops, and more. Adjustable strength.",
    href: "/brine-calculator/",
    keywords: "brine calculator, turkey brine, chicken brine, pork brine, salt brine recipe",
  },
  {
    icon: "🍬",
    title: "Sugar & Salt Concentration",
    description:
      "Calculate sugar percentage, salt content, and Brix for syrups, brines, jams, and fermentations. Perfect for homebrewing and candy making.",
    href: "/sugar-salt-calculator/",
    keywords: "brix calculator, sugar percentage, brine percentage, syrup concentration, homebrewing",
  },
  {
    icon: "🌡️",
    title: "Food Safety Temperature Guide",
    description:
      "USDA safe internal temperatures for every food. Beef, pork, chicken, turkey, seafood — plus doneness guide and danger zone info.",
    href: "/food-safety-temperature-guide/",
    keywords: "food safety temperature, USDA safe temps, chicken temperature, beef doneness, meat thermometer guide",
  },
  {
    icon: "🍺",
    title: "BAC Calculator",
    description:
      "Estimate your Blood Alcohol Content based on drinks, weight, and time. Educational tool for understanding alcohol metabolism.",
    href: "/bac-calculator/",
    keywords: "BAC calculator, blood alcohol content, drink calculator, alcohol estimator, Widmark formula",
  },
  {
    icon: "💰",
    title: "Recipe Cost Calculator",
    description:
      "Calculate total cost and per-serving cost of any recipe. Perfect for meal planning, home bakers, and small food businesses.",
    href: "/recipe-cost-calculator/",
    keywords: "recipe cost, food cost calculator, cost per serving, baking cost, menu pricing",
  },
  {
    icon: "⏱️",
    title: "Cooking Time Calculator",
    description:
      "Adjust cooking times for altitude, different cooking methods, meat doneness, and weight. Works with Fahrenheit and pounds.",
    href: "/cooking-time-calculator/",
    keywords: "cooking time converter, altitude cooking, method conversion, meat cooking time",
  },
  {
    icon: "🍰",
    title: "Baking Pan Size Converter",
    description:
      "Convert recipes between different pan sizes and shapes. Round to square, 8-inch to 9-inch — get the exact ingredient multiplier.",
    href: "/baking-pan-converter/",
    keywords: "baking pan converter, cake pan size, pan substitution, adjust recipe for pan size",
  },
  {
    icon: "🔥",
    title: "Oven Temperature Converter",
    description:
      "Convert between Fahrenheit, Celsius, and gas marks instantly. Includes a cooking temperature guide for roasting, baking, and broiling.",
    href: "/oven-temperature-converter/",
    keywords: "oven temperature conversion, F to C, gas mark, baking temperature, celsius to fahrenheit",
  },
  {
    icon: "🔄",
    title: "Ingredient Substitution Finder",
    description:
      "Missing an ingredient? Find tested substitutes for buttermilk, eggs, flour, brown sugar, butter, and dozens of other pantry staples.",
    href: "/ingredient-substitution-finder/",
    keywords: "ingredient substitute, baking substitution, egg substitute, buttermilk substitute, cooking substitute",
  },
  {
    icon: "📊",
    title: "Printable Conversion Chart",
    description:
      "Free printable kitchen conversion charts. Cups to grams, volume equivalents, oven temps, pan sizes, butter, eggs — print and stick on your fridge.",
    href: "/conversion-chart/",
    keywords: "printable conversion chart, kitchen cheat sheet, cups to grams printable, cooking measurements",
  },
];
---

<BaseLayout
  title="15+ Free Kitchen Calculators — Scale Recipes, Convert Measurements, Plan Meals"
  description="The Kitchen Calc offers 15+ free, easy-to-use calculators for home cooks. Scale recipes, convert measurements, calculate yeast & dough hydration, plan holiday meals, find ingredient substitutes, and more. No sign-up required."
  schema={[siteSchema, faqSchema]}
>
  <!-- Hero Section -->
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-secondary leading-tight mb-6">
        Kitchen Math Made <span class="text-primary">Simple</span>
      </h1>
      <p class="text-lg sm:text-xl text-text-light max-w-2xl mx-auto leading-relaxed mb-8">
        15+ free calculators for home cooks. Scale recipes, calculate yeast and dough hydration,
        plan holiday meals, and convert measurements. No sign-up. No clutter. Just answers.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/recipe-servings-calculator/"
          class="px-8 py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
        >
          Scale a Recipe
        </a>
        <a
          href="/holiday-meal-planner/"
          class="px-8 py-4 bg-white border-2 border-primary text-primary hover:bg-primary/5 font-bold text-lg rounded-xl transition-colors tap-target"
        >
          Plan a Holiday Meal
        </a>
      </div>
    </div>
  </section>

  <!-- Tools Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-secondary text-center mb-12">
      Our Free Kitchen Calculators
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group bg-white rounded-2xl shadow-sm border border-border p-6 hover:border-primary/30 hover:shadow-md transition-all block no-underline"
        >
          <div class="text-4xl mb-4">{tool.icon}</div>
          <h3 class="text-lg font-bold text-secondary mb-2 group-hover:text-primary transition-colors">
            {tool.title}
          </h3>
          <p class="text-sm text-text-light leading-relaxed">{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Why Section -->
  <section class="bg-cream border-y border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-secondary text-center mb-10">
        Why The Kitchen Calc?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-3xl mb-3">📱</div>
          <h3 class="font-bold text-secondary mb-2">Mobile-Friendly</h3>
          <p class="text-sm text-text-light leading-relaxed">
            Designed for your phone. Use it right in the kitchen — big buttons, easy
            scrolling, no zooming required.
          </p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">🎯</div>
          <h3 class="font-bold text-secondary mb-2">US-Centric</h3>
          <p class="text-sm text-text-light leading-relaxed">
            Built for American home cooks. Fahrenheit, pounds, cups, tablespoons —
            the units you actually use.
          </p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">🔒</div>
          <h3 class="font-bold text-secondary mb-2">No Sign-Up</h3>
          <p class="text-sm text-text-light leading-relaxed">
            Just open the page and start calculating. We don't collect your email,
            and we never will.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Preview -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-secondary text-center mb-10">
      Frequently Asked Questions
    </h2>
    <div class="space-y-4">
      <details class="bg-white rounded-xl border border-border group">
        <summary class="px-6 py-4 font-semibold text-secondary cursor-pointer hover:text-primary transition-colors select-none">
          Is this website really free?
        </summary>
        <div class="px-6 pb-4 text-sm text-text-light leading-relaxed">
          Yes, 100% free. We support the site with advertising. No paywalls, no
          "pro" subscriptions, no sign-ups required. Just free calculators for
          home cooks.
        </div>
      </details>
      <details class="bg-white rounded-xl border border-border group">
        <summary class="px-6 py-4 font-semibold text-secondary cursor-pointer hover:text-primary transition-colors select-none">
          Do you save my recipes or meal plans?
        </summary>
        <div class="px-6 pb-4 text-sm text-text-light leading-relaxed">
          No. Everything runs in your browser. We don't store, save, or even
          see the recipes and meal plans you create. Your data stays on your
          device.
        </div>
      </details>
      <details class="bg-white rounded-xl border border-border group">
        <summary class="px-6 py-4 font-semibold text-secondary cursor-pointer hover:text-primary transition-colors select-none">
          Are the calculations accurate?
        </summary>
        <div class="px-6 pb-4 text-sm text-text-light leading-relaxed">
          Our calculators use standard culinary ratios and USDA guidelines. They
          provide reliable estimates, but always use your own judgment and a
          food thermometer when cooking. Baking, in particular, can be sensitive
          to scaling — test large batch changes cautiously.
        </div>
      </details>
      <details class="bg-white rounded-xl border border-border group">
        <summary class="px-6 pb-4 font-semibold text-secondary cursor-pointer hover:text-primary transition-colors select-none">
          Do you support units used outside the US?
        </summary>
        <div class="px-6 pb-4 text-sm text-text-light leading-relaxed">
          Most of our calculators support both US customary units (cups, pounds,
          Fahrenheit) and metric units (grams, milliliters, Celsius). We default
          to US units because our audience is primarily American home cooks.
        </div>
      </details>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-16 text-center">
    <h2 class="text-2xl font-extrabold text-secondary mb-4">
      Ready to cook?
    </h2>
    <p class="text-text-light mb-8 max-w-lg mx-auto">
      Pick a calculator above and get started. No account needed — ever.
    </p>
  </section>
</BaseLayout>
