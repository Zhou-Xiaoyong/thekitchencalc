---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import AmazonProducts from "../components/AmazonProducts.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Sugar & Salt Concentration Calculator",
  url: "https://thekitchencalc.com/sugar-salt-calculator/",
  description: "Calculate sugar percentage, salt percentage, and Brix for recipes, brines, syrups, and fermentations. Convert between weight percentages and measurements.",
  applicationCategory: "CookingApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title="Sugar & Salt Concentration Calculator — Brix & Percentage"
  description="Calculate sugar and salt percentages for recipes, brines, syrups, and fermentations. Brix calculator for jam, candy, homebrewing, and more."
  canonical="https://thekitchencalc.com/sugar-salt-calculator/"
  schema={schema}
>
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Sugar & Salt <span class="text-primary">Concentration Calculator</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Calculate sugar percentage, salt content, and Brix for syrups, brines, jams, and fermentations. Perfect for homebrewing, candy making, and preserving.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <AdSlot position="top" />

    <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
      <div class="mb-6">
        <label class="block text-sm font-semibold text-secondary mb-3">Calculate</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <button
            data-mode="percentage"
            class="mode-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-primary bg-primary/5 text-primary transition-all tap-target active"
          >
            📊 % from Amounts
          </button>
          <button
            data-mode="amount"
            class="mode-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🧂 Amount from %
          </button>
          <button
            data-mode="brix"
            class="mode-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🍬 Brix / Sugar
          </button>
        </div>
      </div>

      <div id="percentage-mode">
        <div class="mb-4">
          <label class="block text-sm font-semibold text-secondary mb-2">Substance</label>
          <select id="substance-pct" class="w-full sm:w-auto px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white">
            <option value="sugar">Sugar (granulated)</option>
            <option value="salt">Salt (table)</option>
            <option value="honey">Honey</option>
            <option value="brown-sugar">Brown Sugar (packed)</option>
          </select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="pct-liquid" class="block text-sm font-semibold text-secondary mb-2">
              Liquid Amount
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                id="pct-liquid"
                min="0"
                value="1000"
                class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
                inputmode="decimal"
              />
              <select
                id="pct-liquid-unit"
                class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
              >
                <option value="g" selected>g (grams)</option>
                <option value="kg">kg</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
                <option value="ml">mL</option>
                <option value="cup">cup</option>
              </select>
            </div>
          </div>
          <div>
            <label for="pct-solid" class="block text-sm font-semibold text-secondary mb-2">
              Sugar / Salt Amount
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                id="pct-solid"
                min="0"
                value="200"
                class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
                inputmode="decimal"
              />
              <select
                id="pct-solid-unit"
                class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
              >
                <option value="g" selected>g (grams)</option>
                <option value="kg">kg</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
                <option value="cup">cup</option>
                <option value="tbsp">tbsp</option>
                <option value="tsp">tsp</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div id="amount-mode" class="hidden">
        <div class="mb-4">
          <label class="block text-sm font-semibold text-secondary mb-2">Substance</label>
          <select id="substance-amt" class="w-full sm:w-auto px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white">
            <option value="sugar">Sugar (granulated)</option>
            <option value="salt">Salt (table)</option>
            <option value="honey">Honey</option>
            <option value="brown-sugar">Brown Sugar (packed)</option>
          </select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="amt-liquid" class="block text-sm font-semibold text-secondary mb-2">
              Liquid Amount
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                id="amt-liquid"
                min="0"
                value="1000"
                class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
                inputmode="decimal"
              />
              <select
                id="amt-liquid-unit"
                class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
              >
                <option value="g" selected>g (grams)</option>
                <option value="kg">kg</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
                <option value="ml">mL</option>
                <option value="cup">cup</option>
              </select>
            </div>
          </div>
          <div>
            <label for="amt-target" class="block text-sm font-semibold text-secondary mb-2">
              Target Percentage
            </label>
            <div class="flex gap-2 items-center">
              <input
                type="number"
                id="amt-target"
                min="0"
                max="100"
                value="20"
                class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
                inputmode="decimal"
              />
              <span class="text-lg font-medium text-text-light">%</span>
            </div>
          </div>
        </div>
        <div class="mb-4">
          <label class="block text-sm font-semibold text-secondary mb-3">Quick Presets</label>
          <div class="flex flex-wrap gap-2">
            <button onclick="setTarget(3.5)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">3.5% (w/w brine)</button>
            <button onclick="setTarget(5)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">5% (w/w brine)</button>
            <button onclick="setTarget(7)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">7% (w/w brine)</button>
            <button onclick="setTarget(20)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">20% (light syrup)</button>
            <button onclick="setTarget(30)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">30% (simple syrup)</button>
            <button onclick="setTarget(50)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">50% (rich syrup)</button>
            <button onclick="setTarget(67)" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">67 Brix (jam set)</button>
          </div>
        </div>
      </div>

      <div id="brix-mode" class="hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="brix-input" class="block text-sm font-semibold text-secondary mb-2">
              Brix (°Bx)
            </label>
            <input
              type="number"
              id="brix-input"
              min="0"
              max="100"
              value="30"
              step="0.1"
              class="w-full px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
              inputmode="decimal"
            />
            <p class="text-xs text-text-light mt-2">1 degree Brix = 1g sugar per 100g solution</p>
          </div>
          <div>
            <label for="brix-volume" class="block text-sm font-semibold text-secondary mb-2">
              Solution Volume / Weight
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                id="brix-volume"
                min="0"
                value="1000"
                class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
                inputmode="decimal"
              />
              <select
                id="brix-unit"
                class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
              >
                <option value="g" selected>g</option>
                <option value="kg">kg</option>
                <option value="ml">mL</option>
                <option value="L">L</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
              </select>
            </div>
          </div>
        </div>
        <div class="p-3 bg-cream/50 rounded-xl text-xs text-text-light">
          <strong>💡 What is Brix?</strong> Degrees Brix (°Bx) measures sugar content. 1 °Bx = 1 gram of sucrose per 100 grams of solution.
          Used in winemaking, brewing, jam making, and maple syrup production.
        </div>
      </div>

      <button
        id="calculate-btn"
        class="w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
      >
        Calculate
      </button>
    </div>

    <AdSlot position="middle" />

    <div id="results-section" class="hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
        <div id="concentration-result"></div>
      </div>
    </div>

    <AmazonProducts category="brewing" title="Measuring & Brewing Tools" />

    <AdSlot position="bottom" />

    <article class="mt-8 bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none">
      <h2>About Sugar & Salt Percentages</h2>
      <p>
        In cooking and brewing, concentration is typically measured as <strong>percentage by weight</strong>
        — meaning the percentage of the total weight that's sugar or salt.
        For example, a 5% salt brine means 5 grams of salt per 100 grams of total solution.
      </p>

      <h2>Ways to Measure Concentration</h2>
      <h3>% by Weight (w/w)</h3>
      <p>
        The most accurate method. Percentage of total weight that's dissolved substance.
        Used in professional baking, brining, and candy making.
      </p>
      <h3>Brix (°Bx)</h3>
      <p>
        One degree Brix equals 1 gram of sucrose in 100 grams of solution.
        Used in winemaking, beer brewing, jam making, and fruit juice production.
        Measured with a refractometer or hydrometer.
      </p>
      <h3>Specific Gravity (SG)</h3>
      <p>
        Ratio of the density of a liquid to the density of water.
        Used in homebrewing to measure alcohol potential.
        Water = 1.000 SG. Sugar increases density.
      </p>

      <h2>Common Concentrations</h2>
      <h3>Salt Brines</h3>
      <ul>
        <li><strong>3.5% (mild):</strong> Delicate fish, long poultry brines</li>
        <li><strong>5% (standard):</strong> Most common for poultry and pork</li>
        <li><strong>7% (strong):</strong> Quick brines, hearty meats</li>
        <li><strong>10% (very strong):</strong> Very fast brines (30 min-2 hours)</li>
      </ul>
      <h3>Sugar Syrups</h3>
      <ul>
        <li><strong>20% (light syrup):</strong> Fruit drinks, sorbet base</li>
        <li><strong>30% (simple syrup):</strong> Cocktails, iced tea (1:1 ratio)</li>
        <li><strong>50% (rich syrup):</strong> Rich simple syrup (2:1 sugar:water)</li>
        <li><strong>67% (jam set point):</strong> Jelly and jam set point</li>
        <li><strong>80%+ (hard crack):</strong> Hard candy, toffee</li>
      </ul>

      <h2>Brix in Winemaking & Brewing</h2>
      <ul>
        <li><strong>Starting Brix for wine:</strong> 22-26 °Bx (dried out grapes can reach 28+)</li>
        <li><strong>Starting Brix for beer:</strong> 10-18 °Bx (varies by beer style)</li>
        <li><strong>Jam set point:</strong> 65-67 °Bx</li>
        <li><strong>Maple syrup (finished):</strong> 66-67 °Bx (66.9% by weight)</li>
      </ul>

      <h2>How to Measure Brix</h2>
      <p>
        <strong>Refractometer:</strong> A handheld device that measures how light bends through a liquid.
        Quick and easy — just a drop of liquid needed. Some models have automatic temperature compensation (ATC).
      </p>
      <p>
        <strong>Hydrometer:</strong> A glass float that measures density. Requires more liquid (typically a sample jar).
        Temperature correction is important since density changes with temperature.
      </p>
    </article>
  </section>
<!-- RELATED_ARTICLES -->
</BaseLayout>

<script>
  let currentMode = "percentage";

  const densities: Record<string, number> = {
    sugar: 200,
    salt: 292,
    honey: 340,
    "brown-sugar": 220,
  };

  const liquidToGrams: Record<string, number> = {
    g: 1,
    kg: 1000,
    oz: 28.3495,
    lb: 453.592,
    ml: 1,
    cup: 240,
  };

  const solidToGrams: Record<string, number> = {
    g: 1,
    kg: 1000,
    oz: 28.3495,
    lb: 453.592,
    cup: null as any,
    tbsp: null as any,
    tsp: null as any,
  };

  function solidAmountToGrams(amount: number, unit: string, substance: string): number {
    if (unit === "g" || unit === "kg" || unit === "oz" || unit === "lb") {
      const factors: Record<string, number> = { g: 1, kg: 1000, oz: 28.3495, lb: 453.592 };
      return amount * factors[unit];
    }
    const perCup = densities[substance];
    if (unit === "cup") return amount * perCup;
    if (unit === "tbsp") return amount * (perCup / 16);
    if (unit === "tsp") return amount * (perCup / 48);
    return amount;
  }

  function gramsToReadable(grams: number, substance: string): string {
    const perCup = densities[substance];
    const cups = grams / perCup;
    const tbsp = cups * 16;
    const oz = grams / 28.3495;

    if (grams < 30) {
      const tsp = grams / (perCup / 48);
      return `${grams.toFixed(1)} g (${tsp.toFixed(1)} tsp)`;
    } else if (cups < 0.5) {
      return `${grams.toFixed(0)} g (${tbsp.toFixed(1)} tbsp / ${oz.toFixed(1)} oz)`;
    }
    return `${grams.toFixed(0)} g (${cups.toFixed(2)} cups / ${oz.toFixed(1)} oz)`;
  }

  function switchMode(mode: string) {
    currentMode = mode;
    document.querySelectorAll(".mode-btn").forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.mode === mode) {
        el.className =
          "mode-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-primary bg-primary/5 text-primary transition-all tap-target active";
      } else {
        el.className =
          "mode-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target";
      }
    });
    document.getElementById("percentage-mode")!.classList.toggle("hidden", mode !== "percentage");
    document.getElementById("amount-mode")!.classList.toggle("hidden", mode !== "amount");
    document.getElementById("brix-mode")!.classList.toggle("hidden", mode !== "brix");
    document.getElementById("results-section")!.classList.add("hidden");
  }

  function setTarget(value: number) {
    (document.getElementById("amt-target") as HTMLInputElement).value = String(value);
  }

  function calculate() {
    const resultDiv = document.getElementById("concentration-result")!;

    if (currentMode === "percentage") {
      const liquidAmt = parseFloat((document.getElementById("pct-liquid") as HTMLInputElement).value) || 0;
      const liquidUnit = (document.getElementById("pct-liquid-unit") as HTMLSelectElement).value;
      const solidAmt = parseFloat((document.getElementById("pct-solid") as HTMLInputElement).value) || 0;
      const solidUnit = (document.getElementById("pct-solid-unit") as HTMLSelectElement).value;
      const substance = (document.getElementById("substance-pct") as HTMLSelectElement).value;

      const liquidGrams = liquidAmt * liquidToGrams[liquidUnit];
      const solidGrams = solidAmountToGrams(solidAmt, solidUnit, substance);
      const totalGrams = liquidGrams + solidGrams;
      const pct = (solidGrams / totalGrams) * 100;

      const substanceNames: Record<string, string> = {
        sugar: "sugar",
        salt: "salt",
        honey: "honey",
        "brown-sugar": "brown sugar",
      };

      resultDiv.innerHTML = `
        <div class="text-center mb-6">
          <p class="text-sm text-text-light mb-1">Concentration</p>
          <p class="text-5xl font-extrabold text-primary mb-2">${pct.toFixed(1)}%</p>
          <p class="text-sm text-text-light">${substanceNames[substance]} by weight (w/w)</p>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-6">
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Liquid</p>
            <p class="text-lg font-bold text-secondary">${liquidGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">${substanceNames[substance].charAt(0).toUpperCase() + substanceNames[substance].slice(1)}</p>
            <p class="text-lg font-bold text-secondary">${solidGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Total</p>
            <p class="text-lg font-bold text-secondary">${totalGrams.toFixed(0)} g</p>
          </div>
        </div>
        ${substance === "sugar" || substance === "honey" ? `
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <p class="text-sm font-bold text-amber-800 mb-1">🍯 Brix Equivalent</p>
          <p class="text-lg font-extrabold text-amber-700">${pct.toFixed(1)} °Bx</p>
          <p class="text-xs text-amber-600 mt-1">Approximate sugar content by refractometer reading</p>
        </div>
        ` : ""}
      `;
    } else if (currentMode === "amount") {
      const liquidAmt = parseFloat((document.getElementById("amt-liquid") as HTMLInputElement).value) || 0;
      const liquidUnit = (document.getElementById("amt-liquid-unit") as HTMLSelectElement).value;
      const targetPct = parseFloat((document.getElementById("amt-target") as HTMLInputElement).value) || 0;
      const substance = (document.getElementById("substance-amt") as HTMLSelectElement).value;

      const liquidGrams = liquidAmt * liquidToGrams[liquidUnit];
      const solidGrams = liquidGrams * (targetPct / (100 - targetPct));
      const totalGrams = liquidGrams + solidGrams;

      const substanceNames: Record<string, string> = {
        sugar: "sugar",
        salt: "salt",
        honey: "honey",
        "brown-sugar": "brown sugar",
      };

      resultDiv.innerHTML = `
        <div class="text-center mb-6">
          <p class="text-sm text-text-light mb-1">${substanceNames[substance].charAt(0).toUpperCase() + substanceNames[substance].slice(1)} Needed for ${targetPct}% Solution (w/w)</p>
          <p class="text-4xl font-extrabold text-primary mb-2">${solidGrams.toFixed(0)} g</p>
          <p class="text-sm text-text-light">${gramsToReadable(solidGrams, substance)}</p>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-6">
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Water</p>
            <p class="text-lg font-bold text-secondary">${liquidGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">${substanceNames[substance].charAt(0).toUpperCase() + substanceNames[substance].slice(1)}</p>
            <p class="text-lg font-bold text-secondary">${solidGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Total Yield</p>
            <p class="text-lg font-bold text-secondary">${totalGrams.toFixed(0)} g</p>
          </div>
        </div>
        <div class="p-3 bg-cream rounded-xl text-xs text-text-light">
          <strong>Tip:</strong> Dissolve ${substanceNames[substance]} in a small amount of warm water first, then top up with cold water to reach the total liquid amount.
        </div>
      `;
    } else {
      const brix = parseFloat((document.getElementById("brix-input") as HTMLInputElement).value) || 0;
      const volume = parseFloat((document.getElementById("brix-volume") as HTMLInputElement).value) || 0;
      const unit = (document.getElementById("brix-unit") as HTMLSelectElement).value;

      const unitFactors: Record<string, number> = { g: 1, kg: 1000, ml: 1, L: 1000, oz: 28.3495, lb: 453.592 };
      const totalGrams = volume * unitFactors[unit];
      const sugarGrams = totalGrams * (brix / 100);
      const waterGrams = totalGrams - sugarGrams;

      const approxSG = 1 + (brix / (258.6 - (brix / 258.2) * 227.1)) / 100;
      const potentialAlcohol = (brix - 2) * 0.55;

      resultDiv.innerHTML = `
        <div class="text-center mb-6">
          <p class="text-sm text-text-light mb-1">Sugar Content</p>
          <p class="text-5xl font-extrabold text-primary mb-2">${brix.toFixed(1)} °Bx</p>
          <p class="text-sm text-text-light">${brix.toFixed(1)}% sugar by weight</p>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-6">
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Total</p>
            <p class="text-lg font-bold text-secondary">${totalGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Sugar</p>
            <p class="text-lg font-bold text-secondary">${sugarGrams.toFixed(0)} g</p>
          </div>
          <div class="bg-cream/50 rounded-xl p-3 text-center">
            <p class="text-xs text-text-light uppercase tracking-wider mb-1">Water</p>
            <p class="text-lg font-bold text-secondary">${waterGrams.toFixed(0)} g</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3">
            <p class="text-xs font-semibold text-amber-700 mb-1">🍺 Specific Gravity</p>
            <p class="text-xl font-bold text-amber-800">${approxSG.toFixed(4)}</p>
            <p class="text-xs text-amber-600">approximate (calculated)</p>
          </div>
          <div class="bg-purple-50 border border-purple-200 rounded-xl p-3">
            <p class="text-xs font-semibold text-purple-700 mb-1">🍷 Potential ABV</p>
            <p class="text-xl font-bold text-purple-800">${potentialAlcohol.toFixed(1)}%</p>
            <p class="text-xs text-purple-600">if fully fermented</p>
          </div>
        </div>
      `;
    }

    document.getElementById("results-section")!.classList.remove("hidden");
    document.getElementById("results-section")!.scrollIntoView({ behavior: "smooth" });
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".mode-btn").forEach((btn) => {
      btn.addEventListener("click", () => switchMode((btn as HTMLElement).dataset.mode!));
    });
    document.getElementById("calculate-btn")!.addEventListener("click", calculate);
    (window as any).setTarget = setTarget;
  });
</script>
