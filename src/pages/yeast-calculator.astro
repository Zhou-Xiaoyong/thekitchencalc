---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import AmazonProducts from "../components/AmazonProducts.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Yeast Calculator",
  url: "https://thekitchencalc.com/yeast-calculator/",
  description: "Calculate the exact amount of yeast needed for bread, pizza, and other baked goods. Supports active dry yeast, instant yeast, and fresh yeast conversions.",
  applicationCategory: "CookingApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title="Yeast Calculator — Bread, Pizza & Baking Yeast Converter"
  description="Calculate how much yeast you need for bread, pizza dough, and more. Convert between active dry yeast, instant yeast, rapid-rise, and fresh yeast with our free calculator."
  canonical="https://thekitchencalc.com/yeast-calculator/"
  schema={schema}
>
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Yeast <span class="text-primary">Calculator</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Figure out exactly how much yeast you need for bread, pizza dough, and more. Convert between active dry, instant, rapid-rise, and fresh yeast instantly.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <AdSlot position="top" />

    <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label for="flour-amount" class="block text-sm font-semibold text-secondary mb-2">
            Flour Amount
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="flour-amount"
              min="0"
              value="500"
              class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
              inputmode="decimal"
            />
            <select
              id="flour-unit"
              class="px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
            >
              <option value="g" selected>grams (g)</option>
              <option value="kg">kilograms (kg)</option>
              <option value="oz">ounces (oz)</option>
              <option value="lb">pounds (lb)</option>
              <option value="cup">cups</option>
            </select>
          </div>
        </div>
        <div>
          <label for="dough-type" class="block text-sm font-semibold text-secondary mb-2">
            Dough Type
          </label>
          <select
            id="dough-type"
            class="w-full px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
          >
            <option value="white-bread">White Bread (standard)</option>
            <option value="whole-wheat">Whole Wheat Bread</option>
            <option value="pizza">Pizza Dough</option>
            <option value="sweet">Sweet Dough / Brioche</option>
            <option value="rolls">Dinner Rolls</option>
            <option value="focaccia">Focaccia</option>
            <option value="sourdough">Sourdough (starter + yeast)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label for="yeast-type" class="block text-sm font-semibold text-secondary mb-2">
            Yeast Type
          </label>
          <select
            id="yeast-type"
            class="w-full px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
          >
            <option value="active-dry" selected>Active Dry Yeast</option>
            <option value="instant">Instant Yeast (Rapid Rise)</option>
            <option value="bread-machine">Bread Machine Yeast</option>
            <option value="fresh">Fresh / Cake Yeast</option>
          </select>
        </div>
        <div>
          <label for="rise-time" class="block text-sm font-semibold text-secondary mb-2">
            Rising Method
          </label>
          <select
            id="rise-time"
            class="w-full px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none bg-white"
          >
            <option value="standard">Standard (1-2 hr rise)</option>
            <option value="slow">Slow / Cold Ferment (fridge)</option>
            <option value="fast">Fast (quick rise, 30-60 min)</option>
          </select>
        </div>
      </div>

      <button
        id="calculate-btn"
        class="w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
      >
        Calculate Yeast Amount
      </button>
    </div>

    <AdSlot position="middle" />

    <div id="results-section" class="hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
        <h2 class="text-xl font-bold text-secondary mb-6">Yeast You'll Need</h2>
        <div id="yeast-results" class="space-y-4">
        </div>
        <div class="mt-6 p-4 bg-cream rounded-xl">
          <h3 class="font-bold text-secondary mb-2">💡 Baking Tip</h3>
          <p class="text-sm text-text-light" id="baking-tip"></p>
        </div>
      </div>
    </div>

    <AmazonProducts category="baking" title="Yeast Baking Essentials" />

    <AdSlot position="bottom" />

    <article class="mt-8 bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none">
      <h2>How to Use the Yeast Calculator</h2>
      <ol>
        <li><strong>Enter your flour amount</strong> — How much flour does your recipe call for, or how much dough do you want to make?</li>
        <li><strong>Choose dough type</strong> — Different doughs need different yeast percentages based on sugar, fat, and rising expectations.</li>
        <li><strong>Pick yeast type</strong> — Are you using active dry, instant, bread machine, or fresh yeast?</li>
        <li><strong>Select rising method</strong> — Slow cold fermentation needs less yeast. Fast rising needs more.</li>
        <li><strong>Calculate</strong> — Get the exact yeast amount plus equivalent measurements in other yeast types.</li>
      </ol>

      <h2>Yeast Conversion Ratios</h2>
      <ul>
        <li><strong>Active Dry → Instant:</strong> Multiply by 0.75 (1 tsp active dry = ¾ tsp instant)</li>
        <li><strong>Instant → Active Dry:</strong> Multiply by 1.33 (1 tsp instant = 1 ⅓ tsp active dry)</li>
        <li><strong>Fresh → Active Dry:</strong> Multiply by 0.5 (1 oz fresh = ½ oz active dry, or about 3 ⅓ tsp)</li>
        <li><strong>Active Dry → Fresh:</strong> Multiply by 2 (1 tsp active dry = 2 tsp fresh cake yeast)</li>
      </ul>

      <h2>Yeast Percentages by Dough Type</h2>
      <p>Yeast is typically measured as a percentage of flour weight (baker's percentage):</p>
      <ul>
        <li><strong>White bread:</strong> 1-1.5% (standard rise), 0.5-0.8% (slow ferment)</li>
        <li><strong>Whole wheat:</strong> 1.2-2% (whole wheat rises more slowly)</li>
        <li><strong>Pizza dough:</strong> 0.5-1% (less yeast for better flavor)</li>
        <li><strong>Sweet dough:</strong> 1.5-3% (sugar and fat slow yeast activity)</li>
      </ul>

      <h2>Tips for Perfect Yeast Dough</h2>
      <h3>Proofing Active Dry Yeast</h3>
      <p>
        Active dry yeast benefits from proofing: dissolve in warm water (105-110°F / 40-43°C)
        with a pinch of sugar. Wait 5-10 minutes — it should foam and smell yeasty.
        If it doesn't foam, the yeast is dead and you need new yeast.
      </p>
      <h3>Instant Yeast = No Proofing</h3>
      <p>
        Instant yeast (also called rapid-rise or bread machine yeast) can be mixed directly
        with dry ingredients. No proofing needed. It's made with finer granules that activate faster.
      </p>
      <h3>Slow Fermentation = Better Flavor</h3>
      <p>
        For the best flavor, use less yeast and let the dough rise slowly in the fridge
        (cold fermentation). A 12-72 hour cold rise develops complex, nuanced flavors
        that you can't get with a quick room-temperature rise.
      </p>
    </article>
  </section>
</BaseLayout>

<script>
  const flourToGrams: Record<string, number> = {
    g: 1,
    kg: 1000,
    oz: 28.3495,
    lb: 453.592,
    cup: 120,
  };

  const yeastPercentages: Record<string, { standard: number; slow: number; fast: number }> = {
    "white-bread": { standard: 0.012, slow: 0.006, fast: 0.018 },
    "whole-wheat": { standard: 0.015, slow: 0.008, fast: 0.022 },
    "pizza": { standard: 0.008, slow: 0.003, fast: 0.015 },
    "sweet": { standard: 0.02, slow: 0.01, fast: 0.03 },
    "rolls": { standard: 0.015, slow: 0.008, fast: 0.022 },
    "focaccia": { standard: 0.01, slow: 0.005, fast: 0.018 },
    "sourdough": { standard: 0.005, slow: 0.002, fast: 0.01 },
  };

  const yeastMultipliers: Record<string, number> = {
    "active-dry": 1,
    "instant": 0.75,
    "bread-machine": 0.75,
    "fresh": 2,
  };

  const yeastNames: Record<string, string> = {
    "active-dry": "Active Dry Yeast",
    "instant": "Instant / Rapid-Rise Yeast",
    "bread-machine": "Bread Machine Yeast",
    "fresh": "Fresh / Cake Yeast",
  };

  const bakingTips: Record<string, string> = {
    "white-bread": "For artisanal bread with great crumb, try a cold ferment (slow rise) in the fridge for 12-24 hours. The flavor development is incredible!",
    "whole-wheat": "Whole wheat flour absorbs more water and rises more slowly. Consider adding 1-2 tbsp extra water per cup and giving it extra rising time.",
    "pizza": "For the best pizza crust flavor, use the slow/cold ferment method. 24-72 hours in the fridge produces that classic pizzeria taste and texture.",
    "sweet": "Sugar and fat slow down yeast activity, so sweet doughs need more yeast. Don't worry — the extra yeast won't make your bread taste yeasty.",
    "rolls": "For soft, fluffy dinner rolls, use bread flour and a slightly higher yeast percentage. The extra protein helps create that light, tender crumb.",
    "focaccia": "Focaccia loves a long, slow rise. The high hydration (typically 75-80%) develops great texture and those signature air pockets.",
    "sourdough": "This is a hybrid recipe using both starter and commercial yeast. For pure sourdough, use 20-30% starter (by flour weight) instead of commercial yeast.",
  };

  function toGrams(amount: number, unit: string): number {
    return amount * flourToGrams[unit];
  }

  function formatAmount(grams: number, type: string): string {
    // ~3.1 g per tsp active dry, ~3.0 g per tsp instant/bread-machine, ~3.4 g per tsp fresh
    const tspPerGram = {
      "active-dry": 0.32,
      "instant": 0.33,
      "bread-machine": 0.33,
      "fresh": 0.29,
    };
    const tsp = grams * tspPerGram[type as keyof typeof tspPerGram];

    let tspDisplay: string;
    if (tsp < 0.1) {
      tspDisplay = `${(tsp * 4).toFixed(1)} tsp (${(tsp * 4 * 3).toFixed(0)} drops)`;
    } else if (tsp < 1) {
      tspDisplay = `${tsp.toFixed(2)} tsp`;
    } else if (tsp < 3) {
      const tbsp = tsp / 3;
      tspDisplay = `${tsp.toFixed(1)} tsp (${tbsp.toFixed(2)} tbsp)`;
    } else {
      const tbsp = tsp / 3;
      tspDisplay = `${tbsp.toFixed(2)} tbsp (${tsp.toFixed(1)} tsp)`;
    }

    if (type === "fresh") {
      const oz = grams / 28.3495;
      return `<strong>${grams.toFixed(1)} g</strong> (${oz.toFixed(2)} oz / ${tspDisplay}) of ${yeastNames[type]}`;
    }

    return `<strong>${grams.toFixed(1)} g</strong> (${tspDisplay}) of ${yeastNames[type]}`;
  }

  function calculate() {
    const flourAmount = parseFloat((document.getElementById("flour-amount") as HTMLInputElement).value) || 0;
    const flourUnit = (document.getElementById("flour-unit") as HTMLSelectElement).value;
    const doughType = (document.getElementById("dough-type") as HTMLSelectElement).value;
    const yeastType = (document.getElementById("yeast-type") as HTMLSelectElement).value;
    const riseTime = (document.getElementById("rise-time") as HTMLSelectElement).value;

    const flourGrams = toGrams(flourAmount, flourUnit);
    const percentage = yeastPercentages[doughType][riseTime as keyof typeof yeastPercentages[string]];
    const baseYeastGrams = flourGrams * percentage;
    const selectedYeastGrams = baseYeastGrams * yeastMultipliers[yeastType];

    const results: string[] = [];
    results.push(`
      <div class="bg-cream rounded-xl p-4">
        <p class="text-sm text-text-light mb-1">Your Yeast Amount</p>
        <p class="text-xl font-bold text-primary">${formatAmount(selectedYeastGrams, yeastType)}</p>
        <p class="text-xs text-text-light mt-2">Based on ${flourGrams.toFixed(0)} g flour at ${(percentage * 100).toFixed(1)}% baker's percentage</p>
      </div>
    `);

    results.push(`
      <div class="border-t border-border pt-4">
        <h3 class="font-semibold text-secondary mb-3">Equivalents in Other Yeast Types</h3>
        <div class="space-y-2">
    `);

    for (const [type, mult] of Object.entries(yeastMultipliers)) {
      if (type === yeastType) continue;
      const equivalent = baseYeastGrams * mult;
      results.push(`
        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-cream/30">
          <span class="text-sm font-medium text-secondary">${yeastNames[type]}</span>
          <span class="text-sm font-bold text-text">${formatAmount(equivalent, type).replace(/<[^>]*>/g, '')}</span>
        </div>
      `);
    }

    results.push(`</div></div>`);

    document.getElementById("yeast-results")!.innerHTML = results.join("");
    document.getElementById("baking-tip")!.textContent = bakingTips[doughType];
    document.getElementById("results-section")!.classList.remove("hidden");
    document.getElementById("results-section")!.scrollIntoView({ behavior: "smooth" });
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("calculate-btn")!.addEventListener("click", calculate);
  });
</script>
