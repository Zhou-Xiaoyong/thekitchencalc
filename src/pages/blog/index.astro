---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import AdSlot from "../../components/AdSlot.astro";

const blogPosts = await getCollection("blog");
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = [...new Set(blogPosts.map((post) => post.data.category))];

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "The Kitchen Calc Blog",
  url: "https://thekitchencalc.com/blog/",
  description:
    "Cooking tips, how-to guides, and kitchen math explained. Learn to scale recipes, convert measurements, and become a better home cook.",
};

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title="Kitchen Tips & How-To Guides | The Kitchen Calc Blog"
  description="Cooking tips, how-to guides, and kitchen math explained. Learn to scale recipes, convert measurements, and become a better home cook."
  canonical="https://thekitchencalc.com/blog/"
  ogType="website"
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 text-center">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">
        The Kitchen Calc Blog
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Cooking Tips &amp; <span class="text-primary">How-To Guides</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Practical kitchen advice, recipe scaling tips, and cooking math made
        simple. Everything you need to cook with confidence.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <AdSlot position="top" />

    <!-- Categories -->
    <div class="flex flex-wrap gap-2 mb-8">
      <span class="text-sm font-medium text-text-light self-center mr-1">
        Categories:
      </span>
      <button
        class="px-3 py-1.5 text-sm font-semibold bg-primary text-white rounded-lg transition-colors"
      >
        All Posts
      </button>
      {categories.map((cat) => (
        <button
          class="px-3 py-1.5 text-sm font-medium bg-cream hover:bg-primary-light/30 text-text-light rounded-lg transition-colors"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="group bg-white rounded-2xl shadow-sm border border-border overflow-hidden hover:border-primary/30 hover:shadow-md transition-all block no-underline"
        >
          <div class="aspect-[16/9] bg-cream flex items-center justify-center text-6xl">
            {post.data.heroImage ? (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <span aria-hidden="true">📝</span>
            )}
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-semibold text-primary bg-primary-light/20 px-2 py-0.5 rounded-full">
                {post.data.category}
              </span>
              <span class="text-xs text-text-light">
                {formatDate(post.data.pubDate)}
              </span>
            </div>
            <h2 class="text-lg font-bold text-secondary mb-2 group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-text-light leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-3 flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
              Read more
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                class="ml-1"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <AdSlot position="middle" />

    <!-- Newsletter CTA -->
    <div class="bg-white rounded-2xl shadow-sm border border-border p-6 sm:p-8 text-center mt-8">
      <h2 class="text-xl sm:text-2xl font-extrabold text-secondary mb-2">
        Get Cooking Tips in Your Inbox
      </h2>
      <p class="text-text-light mb-4 max-w-lg mx-auto">
        Join our weekly newsletter for kitchen hacks, calculator updates, and
        time-saving cooking tips. No spam, unsubscribe anytime.
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Your email address"
          class="flex-1 px-4 py-3 border border-border rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl transition-colors tap-target"
        >
          Subscribe
        </button>
      </form>
    </div>

    <AdSlot position="bottom" />
  </section>
</BaseLayout>
