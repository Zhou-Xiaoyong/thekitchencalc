---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import AmazonProducts from "../components/AmazonProducts.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Holiday Meal Planner",
  url: "https://thekitchencalc.com/holiday-meal-planner/",
  description:
    "Plan the perfect holiday meal. Thanksgiving, Christmas, Easter, Super Bowl, 4th of July BBQ, and more. Calculate how much food you need based on your guest count.",
  applicationCategory: "CookingApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title="Holiday Meal Planner — Thanksgiving, Christmas, BBQ & More"
  description="Plan the perfect holiday meal or party. Thanksgiving, Christmas, Easter, Super Bowl, 4th of July BBQ — calculate exactly how much food to buy for any number of guests."
  canonical="https://thekitchencalc.com/holiday-meal-planner/"
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Holiday Meal <span class="text-primary">Planner</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Hosting Thanksgiving, Christmas, a Super Bowl party, or 4th of July BBQ?
        Tell us your guest count and we'll tell you exactly how much food to buy.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <AdSlot position="top" />

    <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
      <!-- Holiday Selector -->
      <div class="mb-8">
        <label class="block text-sm font-semibold text-secondary mb-3">Which event are you planning?</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="holiday-buttons">
          <button
            data-holiday="thanksgiving"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-primary bg-primary/5 text-primary transition-all tap-target active"
          >
            🦃 Thanksgiving
          </button>
          <button
            data-holiday="christmas"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🎄 Christmas
          </button>
          <button
            data-holiday="easter"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🐰 Easter
          </button>
          <button
            data-holiday="superbowl"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🏈 Super Bowl Party
          </button>
          <button
            data-holiday="bbq"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🍔 BBQ / Cookout
          </button>
          <button
            data-holiday="generic"
            class="holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target"
          >
            🎉 General Party
          </button>
        </div>
      </div>

      <!-- Basic Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label for="adults" class="block text-sm font-semibold text-secondary mb-2">
            Number of Adults
          </label>
          <input
            type="number"
            id="adults"
            min="1"
            max="200"
            value="8"
            class="w-full px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
            inputmode="numeric"
          />
        </div>
        <div>
          <label for="children" class="block text-sm font-semibold text-secondary mb-2">
            Number of Children (under 12)
          </label>
          <input
            type="number"
            id="children"
            min="0"
            max="50"
            value="2"
            class="w-full px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
            inputmode="numeric"
          />
        </div>
      </div>

      <!-- Preferences -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label for="style" class="block text-sm font-semibold text-secondary mb-2">
            Serving Style
          </label>
          <select
            id="style"
            class="w-full px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
          >
            <option value="generous" selected>Generous (plenty of leftovers)</option>
            <option value="standard">Standard (moderate leftovers)</option>
            <option value="light">Light (minimal leftovers)</option>
          </select>
        </div>
        <div>
          <label for="main-protein" class="block text-sm font-semibold text-secondary mb-2">
            Main Protein
          </label>
          <select
            id="main-protein"
            class="w-full px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
          >
            <option value="turkey" selected>Turkey</option>
            <option value="ham">Ham</option>
            <option value="prime_rib">Prime Rib / Beef Roast</option>
            <option value="lamb">Leg of Lamb</option>
            <option value="both">Turkey + Ham Combo</option>
            <option value="bbq_mixed" style="display:none">BBQ Mixed (burgers + dogs + brats)</option>
            <option value="burgers" style="display:none">Burgers Only</option>
            <option value="hotdogs" style="display:none">Hot Dogs Only</option>
            <option value="wings" style="display:none">Chicken Wings</option>
            <option value="fingerfood" style="display:none">Finger Food / Appetizers Only</option>
          </select>
        </div>
      </div>

      <!-- Dietary Preferences -->
      <div class="mb-6">
        <label class="block text-sm font-semibold text-secondary mb-3">
          Dietary Preferences
        </label>
        <div class="flex flex-wrap gap-2">
          <button
            id="diet-veggie"
            class="diet-btn px-4 py-2 rounded-lg text-sm font-medium border border-border hover:border-accent hover:bg-accent/10 transition-all"
            data-diet="vegetarian"
          >
            2 Vegetarians
          </button>
          <button
            id="diet-vegan"
            class="diet-btn px-4 py-2 rounded-lg text-sm font-medium border border-border hover:border-accent hover:bg-accent/10 transition-all"
            data-diet="vegan"
          >
            1 Vegan
          </button>
          <button
            id="diet-gf"
            class="diet-btn px-4 py-2 rounded-lg text-sm font-medium border border-border hover:border-accent hover:bg-accent/10 transition-all"
            data-diet="gluten_free"
          >
            2 Gluten-Free
          </button>
        </div>
        <p class="text-xs text-text-light mt-2">
          Click a button to add or remove dietary requirements.
        </p>
      </div>

      <!-- Sides Toggles -->
      <div class="mb-8">
        <label class="block text-sm font-semibold text-secondary mb-3">
          Sides & Apps You're Serving
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="sides-container">
          {[
            { id: "side-mashed", label: "Mashed Potatoes", def: true, holiday: "traditional" },
            { id: "side-stuffing", label: "Stuffing/Dressing", def: true, holiday: "traditional" },
            { id: "side-gravy", label: "Gravy", def: true, holiday: "traditional" },
            { id: "side-cranberry", label: "Cranberry Sauce", def: true, holiday: "traditional" },
            { id: "side-green-bean", label: "Green Bean Casserole", def: true, holiday: "traditional" },
            { id: "side-sweet-potato", label: "Sweet Potatoes", def: true, holiday: "traditional" },
            { id: "side-rolls", label: "Dinner Rolls", def: true, holiday: "traditional" },
            { id: "side-mac", label: "Mac & Cheese", def: false, holiday: "all" },
            { id: "side-brussels", label: "Brussels Sprouts", def: false, holiday: "traditional" },
            { id: "side-corn", label: "Corn on the Cob", def: false, holiday: "bbq" },
            { id: "side-salad", label: "Green Salad", def: false, holiday: "all" },
            { id: "side-coleslaw", label: "Coleslaw", def: false, holiday: "bbq" },
            { id: "side-baked-beans", label: "Baked Beans", def: false, holiday: "bbq" },
            { id: "side-potato-salad", label: "Potato Salad", def: false, holiday: "bbq" },
            { id: "side-chips", label: "Chips & Dip", def: false, holiday: "party" },
            { id: "side-nachos", label: "Nachos", def: false, holiday: "party" },
            { id: "side-wings", label: "Chicken Wings", def: false, holiday: "party" },
            { id: "side-deviled-eggs", label: "Deviled Eggs", def: false, holiday: "all" },
          ].map((side) => (
            <label class={`side-item flex items-center gap-2 p-2 rounded-lg hover:bg-cream/50 transition-colors cursor-pointer tap-target ${side.holiday !== "traditional" ? "hidden" : ""}`} data-holiday={side.holiday}>
              <input
                type="checkbox"
                id={side.id}
                checked={side.def}
                class="side-toggle w-4 h-4 rounded accent-primary"
              />
              <span class="text-sm font-medium text-text">{side.label}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Desserts -->
      <div class="mb-8">
        <label class="block text-sm font-semibold text-secondary mb-3">
          How many dessert types?
        </label>
        <select
          id="dessert-count"
          class="w-full sm:w-auto px-4 py-3 border border-border rounded-xl text-base focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none"
        >
          <option value="1">1 dessert (e.g., just pie)</option>
          <option value="2" selected>2 desserts (e.g., pie + cake)</option>
          <option value="3">3 desserts</option>
          <option value="4">4+ desserts (dessert table!)</option>
        </select>
      </div>

      <!-- Calculate -->
      <button
        id="plan-btn"
        class="w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
      >
        Plan My Holiday Meal
      </button>
    </div>

    <AdSlot position="middle" />

    <!-- Results -->
    <div id="plan-results-section" class="hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 mt-6">
        <h2 class="text-xl font-bold text-secondary mb-6">
          Your Holiday Shopping List
        </h2>

        <!-- Main Protein -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
            Main Course
          </h3>
          <div id="result-protein" class="space-y-2"></div>
        </div>

        <!-- Sides -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
            Sides & Sauces
          </h3>
          <div id="result-sides" class="space-y-2"></div>
        </div>

        <!-- Desserts -->
        <div class="mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
            Desserts
          </h3>
          <div id="result-desserts" class="space-y-2"></div>
        </div>

        <!-- Drinks -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
            Drinks
          </h3>
          <div id="result-drinks" class="space-y-2"></div>
        </div>

        <!-- Copy -->
        <button
          id="copy-plan"
          class="mt-6 w-full sm:w-auto px-6 py-3 border-2 border-primary text-primary font-bold rounded-xl hover:bg-primary hover:text-white transition-all tap-target"
        >
          Copy Shopping List
        </button>
      </div>
    </div>

    <AmazonProducts category="holiday" title="Holiday Cooking Essentials" />

    <AdSlot position="bottom" />

    <!-- Content -->
    <article class="mt-8 bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none">
      <h2>Holiday & Party Meal Planning Guide</h2>

      <h3>🦃 Thanksgiving</h3>
      <p>
        The average American Thanksgiving dinner serves 10 people. The centerpiece
        is turkey — plan on 1 to 1.5 pounds of turkey per person (bone-in) for
        generous leftovers. A 15 lb turkey feeds about 10–12 people. Classic sides
        include mashed potatoes, stuffing, green bean casserole, and cranberry sauce.
      </p>

      <h3>🎄 Christmas</h3>
      <p>
        Christmas dinners are more varied across the US. Traditional mains include prime rib,
        ham, or roast goose. Side dishes lean toward roasted vegetables, potatoes
        au gratin, and Yorkshire pudding for prime rib dinners. Cookies and fruitcake
        are classic desserts.
      </p>

      <h3>🐰 Easter</h3>
      <p>
        Easter is the third largest food holiday in the US. Ham is the most
        popular main course, followed by leg of lamb. Spring sides like asparagus,
        deviled eggs, scalloped potatoes, and carrot cake are common.
      </p>

      <h3>🏈 Super Bowl & Game Day Parties</h3>
      <p>
        Super Bowl Sunday is the second-largest food consumption day in the US
        (after Thanksgiving). Think finger foods and shareable appetizers:
        chicken wings, nachos, chili, sliders, chips & dip, and pizza.
        Plan for about 8-10 wing pieces per person, or 2-3 sliders per person.
      </p>

      <h3>🍔 BBQ & Cookouts (4th of July, Memorial Day, Labor Day)</h3>
      <p>
        Summer holidays are all about grilling. Burgers, hot dogs, and bratwurst
        are the stars. Plan for 1.5 burgers per person and 1-2 hot dogs per person
        if doing a mix. Classic sides: potato salad, coleslaw, baked beans,
        corn on the cob, and pasta salad.
      </p>

      <h3>🎉 General Party Tips</h3>
      <ul>
        <li><strong>Rule of thumb:</strong> Plan for 6-8 appetizer bites per person for the first hour, then 3-4 per hour after that.</li>
        <li><strong>Better to have too much:</strong> Leftovers are the best part of holiday meals!</li>
        <li><strong>Variety matters:</strong> Include at least one vegetarian option and consider common allergies (nuts, gluten, dairy).</li>
        <li><strong>Drinks:</strong> Plan for 2-3 drinks per person in the first hour, then 1-2 per hour after that.</li>
      </ul>
    </article>
  </section>
<!-- RELATED_ARTICLES -->
</BaseLayout>

<script>
  let activeHoliday = "thanksgiving";
  const dietCounts: Record<string, number> = {};

  const holidayConfig: Record<string, {
    defaultProtein: string;
    showSides: string[];
    proteinOptions: string[];
    resultTitle: string;
    drinkStyle: "dinner" | "party";
  }> = {
    thanksgiving: {
      defaultProtein: "turkey",
      showSides: ["traditional", "all"],
      proteinOptions: ["turkey", "ham", "prime_rib", "lamb", "both"],
      resultTitle: "Your Thanksgiving Shopping List",
      drinkStyle: "dinner",
    },
    christmas: {
      defaultProtein: "ham",
      showSides: ["traditional", "all"],
      proteinOptions: ["ham", "turkey", "prime_rib", "lamb", "both"],
      resultTitle: "Your Christmas Shopping List",
      drinkStyle: "dinner",
    },
    easter: {
      defaultProtein: "ham",
      showSides: ["traditional", "all"],
      proteinOptions: ["ham", "lamb", "turkey", "prime_rib"],
      resultTitle: "Your Easter Shopping List",
      drinkStyle: "dinner",
    },
    superbowl: {
      defaultProtein: "wings",
      showSides: ["party", "bbq", "all"],
      proteinOptions: ["wings", "bbq_mixed", "burgers", "fingerfood"],
      resultTitle: "Your Game Day Shopping List",
      drinkStyle: "party",
    },
    bbq: {
      defaultProtein: "bbq_mixed",
      showSides: ["bbq", "all"],
      proteinOptions: ["bbq_mixed", "burgers", "hotdogs", "wings"],
      resultTitle: "Your BBQ Shopping List",
      drinkStyle: "party",
    },
    generic: {
      defaultProtein: "bbq_mixed",
      showSides: ["bbq", "party", "traditional", "all"],
      proteinOptions: ["bbq_mixed", "burgers", "turkey", "ham", "wings", "fingerfood"],
      resultTitle: "Your Party Shopping List",
      drinkStyle: "party",
    },
  };

  function switchHoliday(h: string) {
    activeHoliday = h;
    const config = holidayConfig[h];

    // Update holiday buttons
    document.querySelectorAll(".holiday-btn").forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.holiday === h) {
        el.className =
          "holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-primary bg-primary/5 text-primary transition-all tap-target active";
      } else {
        el.className =
          "holiday-btn px-4 py-3 rounded-xl text-sm font-bold border-2 border-border text-text-light hover:border-primary/30 transition-all tap-target";
      }
    });

    // Update protein options
    const proteinSelect = document.getElementById("main-protein") as HTMLSelectElement;
    const allProteins = proteinSelect.options;
    for (let i = 0; i < allProteins.length; i++) {
      const opt = allProteins[i];
      opt.style.display = config.proteinOptions.includes(opt.value) ? "" : "none";
    }
    if (!config.proteinOptions.includes(proteinSelect.value)) {
      proteinSelect.value = config.defaultProtein;
    }

    // Update sides
    document.querySelectorAll(".side-item").forEach((el) => {
      const sideHoliday = (el as HTMLElement).dataset.holiday!;
      const show = config.showSides.includes(sideHoliday);
      (el as HTMLElement).classList.toggle("hidden", !show);
    });

    // Update results section heading
    document.querySelector("#plan-results-section h2")!.textContent = config.resultTitle;

    // Hide results when switching
    document.getElementById("plan-results-section")!.classList.add("hidden");
  }

  function calculate() {
    const adults = parseInt((document.getElementById("adults") as HTMLInputElement).value) || 1;
    const children = parseInt((document.getElementById("children") as HTMLInputElement).value) || 0;
    const style = (document.getElementById("style") as HTMLSelectElement).value;
    const protein = (document.getElementById("main-protein") as HTMLSelectElement).value;
    const desserts = parseInt((document.getElementById("dessert-count") as HTMLSelectElement).value);

    const effectiveAdults = adults + children * 0.6;
    const vegCount = dietCounts["vegetarian"] || 0;
    const veganCount = dietCounts["vegan"] || 0;

    const styleMultiplier = style === "generous" ? 1.3 : style === "light" ? 0.8 : 1.0;

    const activeSides: string[] = [];
    document.querySelectorAll(".side-toggle").forEach((cb) => {
      const parent = (cb as HTMLElement).closest(".side-item");
      if (!parent || parent.classList.contains("hidden")) return;
      if ((cb as HTMLInputElement).checked) activeSides.push((cb as HTMLInputElement).id);
    });

    // Protein calculation
    const proteinResults: string[] = [];

    if (protein === "turkey") {
      const lbs = Math.ceil(effectiveAdults * 1.25 * styleMultiplier);
      proteinResults.push(`🦃 <strong>${lbs} lb</strong> whole turkey`);
      proteinResults.push(`    (Thaw: ${Math.ceil(lbs / 5)} days in fridge. Roast at 325°F: ~${Math.round(lbs * 13)} min)`);
    } else if (protein === "ham") {
      const lbs = Math.ceil(effectiveAdults * 0.75 * styleMultiplier);
      proteinResults.push(`🐖 <strong>${lbs} lb</strong> bone-in ham`);
    } else if (protein === "prime_rib") {
      const lbs = Math.ceil(effectiveAdults * 0.8 * styleMultiplier * 1.2);
      proteinResults.push(`🥩 <strong>${lbs} lb</strong> prime rib roast`);
    } else if (protein === "lamb") {
      const lbs = Math.ceil(effectiveAdults * 0.75 * styleMultiplier);
      proteinResults.push(`🐑 <strong>${lbs} lb</strong> leg of lamb`);
    } else if (protein === "both") {
      const turkeyLbs = Math.ceil(effectiveAdults * 0.7 * styleMultiplier);
      const hamLbs = Math.ceil(effectiveAdults * 0.5 * styleMultiplier);
      proteinResults.push(`🦃 <strong>${turkeyLbs} lb</strong> turkey`);
      proteinResults.push(`🐖 <strong>${hamLbs} lb</strong> ham`);
    } else if (protein === "bbq_mixed") {
      const burgers = Math.ceil(effectiveAdults * 1.2 * styleMultiplier);
      const hotdogs = Math.ceil(effectiveAdults * 0.8 * styleMultiplier);
      const brats = Math.ceil(effectiveAdults * 0.5 * styleMultiplier);
      const burgerLbs = Math.ceil(burgers * 0.25);
      proteinResults.push(`🍔 <strong>${burgers}</strong> burger patties (${burgerLbs} lb ground beef)`);
      proteinResults.push(`🌭 <strong>${hotdogs}</strong> hot dogs`);
      proteinResults.push(`🌭 <strong>${brats}</strong> bratwurst / sausages`);
      proteinResults.push(`    Plus buns for each (+10% extra just in case)`);
    } else if (protein === "burgers") {
      const count = Math.ceil(effectiveAdults * 1.8 * styleMultiplier);
      const lbs = Math.ceil(count * 0.25);
      proteinResults.push(`🍔 <strong>${count}</strong> burger patties (${lbs} lb ground beef)`);
      proteinResults.push(`    <strong>${count}</strong> hamburger buns (+ extra)`);
    } else if (protein === "hotdogs") {
      const count = Math.ceil(effectiveAdults * 2 * styleMultiplier);
      proteinResults.push(`🌭 <strong>${count}</strong> hot dogs`);
      proteinResults.push(`    <strong>${Math.ceil(count / 8)}</strong> packs of buns`);
    } else if (protein === "wings") {
      const pieces = Math.ceil(effectiveAdults * 8 * styleMultiplier);
      const lbs = Math.ceil(pieces * 0.1);
      proteinResults.push(`🍗 <strong>${pieces}</strong> chicken wings (${lbs} lb)`);
      proteinResults.push(`    About ${Math.ceil(pieces / 12)} dozen. Plan 8-10 per person for game day!`);
    } else if (protein === "fingerfood") {
      const bites = Math.ceil(effectiveAdults * 8 * styleMultiplier);
      proteinResults.push(`🧀 <strong>${bites}+</strong> appetizer bites total`);
      proteinResults.push(`    Mix of 3-5 types: meatballs, sliders, spring rolls, etc.`);
    }

    if (vegCount > 0 || veganCount > 0) {
      proteinResults.push(`🥬 <strong>${vegCount + veganCount} servings</strong> of vegetarian/vegan option`);
    }

    // Sides calculation
    const sidePortions: Record<string, { perPerson: number; unit: string; label: string }> = {
      "side-mashed": { perPerson: 0.5, unit: "lb", label: "Mashed Potatoes" },
      "side-stuffing": { perPerson: 0.75, unit: "cup", label: "Stuffing/Dressing" },
      "side-gravy": { perPerson: 0.33, unit: "cup", label: "Gravy" },
      "side-cranberry": { perPerson: 0.25, unit: "cup", label: "Cranberry Sauce" },
      "side-green-bean": { perPerson: 0.5, unit: "cup", label: "Green Bean Casserole" },
      "side-sweet-potato": { perPerson: 0.5, unit: "cup", label: "Sweet Potatoes" },
      "side-rolls": { perPerson: 1.5, unit: "rolls", label: "Dinner Rolls" },
      "side-mac": { perPerson: 0.5, unit: "cup", label: "Mac & Cheese" },
      "side-brussels": { perPerson: 0.33, unit: "lb", label: "Brussels Sprouts" },
      "side-corn": { perPerson: 1, unit: "ear", label: "Corn on the Cob" },
      "side-salad": { perPerson: 1.5, unit: "cup", label: "Green Salad" },
      "side-coleslaw": { perPerson: 0.5, unit: "cup", label: "Coleslaw" },
      "side-baked-beans": { perPerson: 0.5, unit: "cup", label: "Baked Beans" },
      "side-potato-salad": { perPerson: 0.5, unit: "cup", label: "Potato Salad" },
      "side-chips": { perPerson: 2, unit: "oz", label: "Potato Chips" },
      "side-nachos": { perPerson: 8, unit: "chips", label: "Nachos (with toppings)" },
      "side-wings": { perPerson: 5, unit: "pieces", label: "Bonus Chicken Wings" },
      "side-deviled-eggs": { perPerson: 2, unit: "halves", label: "Deviled Eggs" },
    };

    const sideResults: string[] = [];
    activeSides.forEach((id) => {
      const s = sidePortions[id];
      if (!s) return;
      const amt = Math.ceil(effectiveAdults * s.perPerson * styleMultiplier);
      sideResults.push(`🍽️ <strong>${amt} ${s.unit}</strong> — ${s.label}`);
    });

    // Dessert
    const dessertResults: string[] = [];
    const slicesPerPerson = desserts > 1 ? 0.75 : 1;
    const totalSlices = Math.ceil(effectiveAdults * slicesPerPerson * styleMultiplier);
    dessertResults.push(`🍰 <strong>${totalSlices} slices</strong> total (${desserts} type${desserts > 1 ? "s" : ""})`);
    const piesPer = Math.ceil(totalSlices / desserts / 8);
    dessertResults.push(`    Plan for about <strong>${piesPer * desserts} pies/cakes</strong> (8 slices each)`);

    // Drinks
    const drinkResults: string[] = [];
    const config = holidayConfig[activeHoliday];

    if (config.drinkStyle === "dinner") {
      drinkResults.push(`🍷 <strong>${Math.ceil(effectiveAdults * 0.5)} bottles</strong> of wine (~5 glasses each)`);
      drinkResults.push(`🍺 <strong>${Math.ceil(effectiveAdults * 1.5)} servings</strong> of beer/cider`);
      drinkResults.push(`🥤 <strong>${Math.ceil(effectiveAdults * 2)} drinks</strong> of soda / sparkling water`);
    } else {
      drinkResults.push(`🍺 <strong>${Math.ceil(effectiveAdults * 3)} servings</strong> of beer/cider`);
      drinkResults.push(`🍷 <strong>${Math.ceil(effectiveAdults * 0.3)} bottles</strong> of wine`);
      drinkResults.push(`🥤 <strong>${Math.ceil(effectiveAdults * 2.5)} drinks</strong> of soda / sparkling water`);
      drinkResults.push(`💧 <strong>${Math.ceil(effectiveAdults * 1)}</strong> bottles of water`);
    }

    // Render
    document.getElementById("result-protein")!.innerHTML = proteinResults
      .map((r) => `<div class="flex items-center py-1 text-sm">${r}</div>`).join("");
    document.getElementById("result-sides")!.innerHTML = sideResults
      .map((r) => `<div class="flex items-center py-1 text-sm">${r}</div>`).join("");
    document.getElementById("result-desserts")!.innerHTML = dessertResults
      .map((r) => `<div class="flex items-center py-1 text-sm">${r}</div>`).join("");
    document.getElementById("result-drinks")!.innerHTML = drinkResults
      .map((r) => `<div class="flex items-center py-1 text-sm">${r}</div>`).join("");

    document.querySelector("#plan-results-section h2")!.textContent = config.resultTitle;

    const section = document.getElementById("plan-results-section")!;
    section.classList.remove("hidden");
    section.scrollIntoView({ behavior: "smooth" });
  }

  function copyPlan() {
    const parts = [
      document.getElementById("result-protein")!.innerText,
      document.getElementById("result-sides")!.innerText,
      document.getElementById("result-desserts")!.innerText,
      document.getElementById("result-drinks")!.innerText,
    ];
    navigator.clipboard.writeText(parts.join("\n")).then(() => {
      const btn = document.getElementById("copy-plan")!;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = "Copy Shopping List"), 2000);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".holiday-btn").forEach((btn) => {
      btn.addEventListener("click", () => switchHoliday((btn as HTMLElement).dataset.holiday!));
    });
    document.getElementById("plan-btn")!.addEventListener("click", calculate);
    document.getElementById("copy-plan")!.addEventListener("click", copyPlan);

    document.querySelectorAll(".diet-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const diet = (btn as HTMLElement).dataset.diet!;
        if (dietCounts[diet]) {
          delete dietCounts[diet];
          btn.classList.remove("border-accent", "bg-accent/10");
        } else {
          const count = diet === "vegetarian" ? 2 : diet === "gluten_free" ? 2 : 1;
          dietCounts[diet] = count;
          btn.classList.add("border-accent", "bg-accent/10");
        }
      });
    });

    (window as any).switchHoliday = switchHoliday;
  });
</script>
