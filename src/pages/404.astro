---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist. Head back to The Kitchen Calc for free recipe scaling, measurement converters, and other kitchen calculators."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="text-6xl mb-6">🥘</div>
    <h1 class="text-4xl font-extrabold text-secondary mb-4">404</h1>
    <p class="text-lg text-text-light mb-8">
      Looks like that recipe page doesn't exist. Let's get you back to the kitchen.
    </p>
    <a
      href="/"
      class="inline-block px-8 py-4 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl transition-colors tap-target"
    >
      Back to Home
    </a>
  </section>
</BaseLayout>
