---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Recipe Servings Calculator",
  url: "https://thekitchencalc.com/recipe-servings-calculator/",
  description:
    "Free tool to scale recipe ingredients up or down. Convert servings and adjust ingredient quantities with fraction-friendly results.",
  applicationCategory: "CookingApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title="Recipe Servings Calculator — Scale Any Recipe Instantly"
  description="Scale your favorite recipes up or down in seconds. Convert servings and adjust ingredient quantities with our free, fraction-friendly calculator. Works with cups, tablespoons, ounces, and more."
  canonical="https://thekitchencalc.com/recipe-servings-calculator/"
  ogType="website"
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-secondary leading-tight mb-4">
        Recipe Servings <span class="text-primary">Calculator</span>
      </h1>
      <p class="text-base sm:text-lg text-text-light max-w-2xl mx-auto leading-relaxed">
        Enter your recipe's current servings, add your ingredients, and pick
        your target servings. We'll scale everything for you — fractions and all.
      </p>
    </div>
  </section>

  <!-- Calculator Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- Ad Top -->
    <AdSlot position="top" />

    <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
      <!-- Servings Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label
            for="original-servings"
            class="block text-sm font-semibold text-secondary mb-2"
          >
            Original Recipe Serves
          </label>
          <input
            type="number"
            id="original-servings"
            min="1"
            max="999"
            value="4"
            class="w-full px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-shadow"
            inputmode="numeric"
          />
        </div>
        <div>
          <label
            for="target-servings"
            class="block text-sm font-semibold text-secondary mb-2"
          >
            Desired Servings
          </label>
          <input
            type="number"
            id="target-servings"
            min="1"
            max="999"
            value="6"
            class="w-full px-4 py-3 border border-border rounded-xl text-lg font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-shadow"
            inputmode="numeric"
          />
        </div>
      </div>

      <!-- Scale factor display -->
      <div
        id="scale-display"
        class="mb-6 p-3 bg-cream rounded-xl text-center text-sm font-medium text-text-light hidden"
      >
        Scale factor: <span id="scale-factor" class="font-bold text-primary">1.5x</span>
      </div>

      <!-- Ingredients Table -->
      <h2 class="text-lg font-bold text-secondary mb-3">Ingredients</h2>

      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <table class="w-full min-w-[480px]" id="ingredients-table">
          <thead>
            <tr class="text-xs font-semibold text-text-light uppercase tracking-wider border-b border-border">
              <th class="text-left py-3 pr-2 pl-4 sm:pl-0 w-8">#</th>
              <th class="text-left py-3 px-2">Ingredient</th>
              <th class="text-right py-3 px-2 w-24">Amount</th>
              <th class="text-left py-3 px-2 w-24">Unit</th>
              <th class="text-right py-3 pl-2 pr-4 sm:pr-0 w-12"></th>
            </tr>
          </thead>
          <tbody id="ingredients-body">
            <!-- Rows added via JS -->
          </tbody>
        </table>
      </div>

      <!-- Add Ingredient Button -->
      <button
        id="add-ingredient"
        class="mt-4 w-full sm:w-auto px-5 py-3 border-2 border-dashed border-border rounded-xl text-sm font-semibold text-text-light hover:border-primary hover:text-primary hover:bg-primary-light/20 transition-all flex items-center justify-center gap-2 tap-target"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Ingredient
      </button>

      <!-- Quick Fill Helpers -->
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="text-xs text-text-light font-medium self-center mr-1">Quick fill:</span>
        <button onclick="fillSampleCookie()" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">
          Cookie Recipe
        </button>
        <button onclick="fillSamplePasta()" class="px-3 py-1.5 text-xs font-medium bg-cream hover:bg-primary-light/30 rounded-lg transition-colors">
          Pasta Sauce
        </button>
        <button onclick="clearIngredients()" class="px-3 py-1.5 text-xs font-medium text-red-500 bg-red-50 hover:bg-red-100 rounded-lg transition-colors">
          Clear All
        </button>
      </div>

      <!-- Calculate Button -->
      <button
        id="calculate-btn"
        class="mt-6 w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-lg rounded-xl transition-colors shadow-sm tap-target"
      >
        Scale My Recipe
      </button>
    </div>

    <!-- Ad Middle -->
    <AdSlot position="middle" />

    <!-- Results -->
    <div id="results-section" class="hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h2 class="text-xl font-bold text-secondary">Scaled Ingredients</h2>
          <div class="flex gap-2">
            <button
              id="copy-results"
              class="px-4 py-2 text-sm font-semibold border border-border rounded-lg hover:bg-cream transition-colors tap-target"
            >
              Copy
            </button>
            <button
              id="print-results"
              class="px-4 py-2 text-sm font-semibold border border-border rounded-lg hover:bg-cream transition-colors tap-target"
            >
              Print
            </button>
          </div>
        </div>
        <div
          id="scaled-results"
          class="space-y-2"
        >
          <!-- Filled by JS -->
        </div>
      </div>
    </div>

    <AdSlot position="bottom" />

    <!-- How It Works / FAQ Content -->
    <article class="mt-8 bg-white rounded-2xl shadow-sm border border-border p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none">
      <h2>How to Use the Recipe Servings Calculator</h2>
      <ol>
        <li><strong>Set the original servings</strong> — How many people does your recipe currently serve?</li>
        <li><strong>Add your ingredients</strong> — For each ingredient, enter the name, amount, and unit (cups, tablespoons, teaspoons, ounces, etc.).</li>
        <li><strong>Set your target servings</strong> — How many servings do you need?</li>
        <li><strong>Hit "Scale My Recipe"</strong> — We'll multiply each ingredient by the correct ratio and display the results in easy-to-read fractions.</li>
      </ol>

      <h2>Supported Units</h2>
      <ul>
        <li>Volume: cups, tablespoons (tbsp), teaspoons (tsp), fluid ounces (fl oz), milliliters (ml), liters (L)</li>
        <li>Weight: pounds (lb), ounces (oz), grams (g), kilograms (kg)</li>
        <li>Count: whole units (e.g., eggs, garlic cloves, chicken breasts)</li>
      </ul>

      <h2>Frequently Asked Questions</h2>
      <h3>Does scaling work for baking recipes?</h3>
      <p>
        Yes, but with caution. Baking is chemistry — scaling a cake recipe from 8
        servings to 50 may affect texture and baking time. For large scaling jumps,
        test in batches rather than scaling all at once.
      </p>
      <h3>How are fractions displayed?</h3>
      <p>
        We show results in kitchen-friendly formats: 1/4, 1/3, 1/2, 2/3, 3/4, plus
        whole numbers. If you need 1.33 cups, we'll show "1 1/3 cups."
      </p>
    </article>
  </section>
</BaseLayout>

<script>
  // ============ STATE ============
  const units = [
    { value: "cup", label: "cup(s)" },
    { value: "tbsp", label: "tablespoon(s)" },
    { value: "tsp", label: "teaspoon(s)" },
    { value: "fl_oz", label: "fluid ounce(s)" },
    { value: "ml", label: "milliliter(s)" },
    { value: "L", label: "liter(s)" },
    { value: "lb", label: "pound(s)" },
    { value: "oz", label: "ounce(s)" },
    { value: "g", label: "gram(s)" },
    { value: "kg", label: "kilogram(s)" },
    { value: "whole", label: "whole (count)" },
  ];

  let ingredients: { name: string; amount: string; unit: string }[] = [];

  // ============ UTILS ============
  function toFraction(decimal: number): string {
    if (decimal === 0) return "0";
    const whole = Math.floor(decimal);
    const frac = decimal - whole;
    if (frac < 0.01) return String(whole);

    const fractions: [number, string][] = [
      [0.5, "1/2"],
      [0.25, "1/4"],
      [0.75, "3/4"],
      [0.33, "1/3"],
      [0.67, "2/3"],
      [0.125, "1/8"],
      [0.375, "3/8"],
      [0.625, "5/8"],
      [0.875, "7/8"],
      [0.2, "1/5"],
      [0.4, "2/5"],
      [0.6, "3/5"],
      [0.8, "4/5"],
    ];

    let best = { diff: 1, label: "" };
    for (const [val, label] of fractions) {
      const d = Math.abs(frac - val);
      if (d < best.diff) {
        best = { diff: d, label };
      }
    }

    if (best.diff < 0.05) {
      return whole > 0 ? `${whole} ${best.label}` : best.label;
    }

    // Fallback to decimal with 2 places
    const dec = decimal.toFixed(2);
    return whole > 0 ? `${whole}.${dec.split(".")[1]}` : dec;
  }

  function unitLabel(unit: string): string {
    const found = units.find((u) => u.value === unit);
    return found ? found.label : unit;
  }

  // ============ RENDER TABLE ============
  function renderTable() {
    const tbody = document.getElementById("ingredients-body")!;
    tbody.innerHTML = ingredients
      .map(
        (ing, i) => `
      <tr class="border-b border-border/50 hover:bg-cream/50 transition-colors">
        <td class="py-3 pr-2 pl-4 sm:pl-0 text-sm text-text-light">${i + 1}</td>
        <td class="py-3 px-2">
          <input
            type="text"
            class="ing-name w-full px-3 py-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
            value="${ing.name}"
            placeholder="e.g. All-purpose flour"
          />
        </td>
        <td class="py-3 px-2">
          <input
            type="number"
            step="any"
            class="ing-amount w-full px-3 py-2 border border-border rounded-lg text-sm text-right focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
            value="${ing.amount}"
            min="0"
            inputmode="decimal"
          />
        </td>
        <td class="py-3 px-2">
          <select class="ing-unit w-full px-2 py-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
            ${units
              .map(
                (u) =>
                  `<option value="${u.value}" ${u.value === ing.unit ? "selected" : ""}>${u.label}</option>`
              )
              .join("")}
          </select>
        </td>
        <td class="py-3 pl-2 pr-4 sm:pr-0 text-center">
          <button
            class="remove-ing tap-target text-red-400 hover:text-red-600 transition-colors p-1"
            data-index="${i}"
            aria-label="Remove ingredient"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </td>
      </tr>
    `
      )
      .join("");

    // Attach remove handlers
    tbody.querySelectorAll(".remove-ing").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        ingredients.splice(idx, 1);
        renderTable();
      });
    });
  }

  function syncFromTable() {
    const rows = document.querySelectorAll("#ingredients-body tr");
    ingredients = Array.from(rows).map((row) => ({
      name: (row.querySelector(".ing-name") as HTMLInputElement).value,
      amount: (row.querySelector(".ing-amount") as HTMLInputElement).value,
      unit: (row.querySelector(".ing-unit") as HTMLSelectElement).value,
    }));
  }

  // ============ CALCULATE ============
  function calculate() {
    syncFromTable();
    const origInput = document.getElementById("original-servings") as HTMLInputElement;
    const targetInput = document.getElementById("target-servings") as HTMLInputElement;
    const origServings = parseFloat(origInput.value) || 1;
    const targetServings = parseFloat(targetInput.value) || 1;
    const scale = targetServings / origServings;

    // Update scale display
    document.getElementById("scale-display")!.classList.remove("hidden");
    document.getElementById("scale-factor")!.textContent = `${scale.toFixed(2)}x`;

    // Generate results
    const resultsDiv = document.getElementById("scaled-results")!;
    if (ingredients.length === 0) {
      resultsDiv.innerHTML =
        '<p class="text-text-light text-center py-4">Add at least one ingredient to see results.</p>';
      document.getElementById("results-section")!.classList.remove("hidden");
      return;
    }

    resultsDiv.innerHTML = ingredients
      .map((ing, i) => {
        const amt = parseFloat(ing.amount) || 0;
        const scaled = amt * scale;
        if (scaled === 0) return "";
        return `
        <div class="flex items-center justify-between py-2 px-3 rounded-lg ${
          i % 2 === 0 ? "bg-cream/50" : ""
        }">
          <span class="text-sm font-medium text-secondary">${ing.name || `Ingredient ${i + 1}`}</span>
          <span class="text-sm font-bold text-primary tabular-nums">
            ${toFraction(scaled)} ${unitLabel(ing.unit)}
          </span>
        </div>
      `;
      })
      .join("");

    document.getElementById("results-section")!.classList.remove("hidden");
    document.getElementById("results-section")!.scrollIntoView({ behavior: "smooth" });
  }

  // ============ ACTIONS ============
  function addIngredient(name = "", amount = "", unit = "cup") {
    ingredients.push({ name, amount, unit });
    renderTable();
  }

  function clearIngredients() {
    ingredients = [];
    renderTable();
    document.getElementById("results-section")!.classList.add("hidden");
    document.getElementById("scale-display")!.classList.add("hidden");
  }

  function fillSampleCookie() {
    ingredients = [
      { name: "All-purpose flour", amount: "2.25", unit: "cup" },
      { name: "Butter (unsalted)", amount: "1", unit: "cup" },
      { name: "Granulated sugar", amount: "0.75", unit: "cup" },
      { name: "Brown sugar", amount: "0.75", unit: "cup" },
      { name: "Eggs", amount: "2", unit: "whole" },
      { name: "Vanilla extract", amount: "2", unit: "tsp" },
      { name: "Baking soda", amount: "1", unit: "tsp" },
      { name: "Salt", amount: "0.5", unit: "tsp" },
      { name: "Chocolate chips", amount: "2", unit: "cup" },
    ];
    (document.getElementById("original-servings") as HTMLInputElement).value = "24";
    (document.getElementById("target-servings") as HTMLInputElement).value = "48";
    renderTable();
  }

  function fillSamplePasta() {
    ingredients = [
      { name: "Spaghetti", amount: "1", unit: "lb" },
      { name: "Olive oil", amount: "2", unit: "tbsp" },
      { name: "Garlic cloves", amount: "4", unit: "whole" },
      { name: "Crushed tomatoes", amount: "28", unit: "oz" },
      { name: "Fresh basil", amount: "0.25", unit: "cup" },
      { name: "Parmesan cheese", amount: "0.5", unit: "cup" },
      { name: "Red pepper flakes", amount: "0.5", unit: "tsp" },
    ];
    (document.getElementById("original-servings") as HTMLInputElement).value = "4";
    (document.getElementById("target-servings") as HTMLInputElement).value = "6";
    renderTable();
  }

  function copyResults() {
    syncFromTable();
    const origServings = parseFloat(
      (document.getElementById("original-servings") as HTMLInputElement).value
    );
    const targetServings = parseFloat(
      (document.getElementById("target-servings") as HTMLInputElement).value
    );
    const scale = targetServings / origServings;

    const lines = ingredients
      .map((ing) => {
        const scaled = (parseFloat(ing.amount) || 0) * scale;
        if (scaled === 0) return "";
        return `${toFraction(scaled)} ${unitLabel(ing.unit)} ${ing.name}`;
      })
      .filter(Boolean);

    navigator.clipboard.writeText(lines.join("\n")).then(() => {
      const btn = document.getElementById("copy-results")!;
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = orig), 2000);
    });
  }

  function printResults() {
    window.print();
  }

  // ============ INIT ============
  document.addEventListener("DOMContentLoaded", () => {
    // Add default ingredients
    fillSampleCookie();

    // Handlers
    document.getElementById("add-ingredient")!.addEventListener("click", () => addIngredient());
    document.getElementById("calculate-btn")!.addEventListener("click", calculate);
    document.getElementById("copy-results")!.addEventListener("click", copyResults);
    document.getElementById("print-results")!.addEventListener("click", printResults);

    // Expose global helpers
    (window as any).fillSampleCookie = fillSampleCookie;
    (window as any).fillSamplePasta = fillSamplePasta;
    (window as any).clearIngredients = clearIngredients;
  });
</script>
